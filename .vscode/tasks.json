{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Source/Binguin/Binguin.Race.sln",
        "--configuration",
        "Release",
        "--nologo",
        "--verbosity",
        "minimal"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "构建 Release 并复制 Binguin.dll 到 Assemblies；依赖路径读取 Binguin.local.props。"
    }
  ]
}
