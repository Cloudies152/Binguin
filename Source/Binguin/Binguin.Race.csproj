<Project Sdk="Microsoft.NET.Sdk">
  <!-- RimWorld 1.7 使用 .NET 10；固定参考包自动还原，无需本机游戏或 HAR 路径。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>5</LangVersion>
    <AssemblyName>Binguin</AssemblyName>
    <RootNamespace>Binguin</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
    <RimWorldReferenceVersion>1.7.4985-unstable</RimWorldReferenceVersion>
  </PropertyGroup>
  <Import Project="Binguin.local.props" Condition="Exists('Binguin.local.props')" />
  <PropertyGroup>
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(RimWorldDir)' != ''">$(RimWorldDir)</ManagedDir>
    <CustomOutputDir Condition="'$(CustomOutputDir)' == ''">$(MSBuildProjectDirectory)/../../</CustomOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldReferenceVersion)" PrivateAssets="all" ExcludeAssets="runtime" Condition="'$(ManagedDir)' == ''" />
  </ItemGroup>
  <ItemGroup Condition="'$(ManagedDir)' != ''">
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(ManagedDir)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(ManagedDir)/Waylith.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckDependencyPaths" BeforeTargets="ResolveAssemblyReferences" Condition="'$(ManagedDir)' != '' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" Code="BINGUIN003" Text="找不到 RimWorld 1.7 引用：%(Reference.HintPath)。省略 RimWorldDir/ManagedDir 可自动使用参考包。" />
  </Target>
  <Target Name="CopyToCustomDirectory" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CustomOutputDir)/Assemblies" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已复制 $(TargetFileName) 到 $(CustomOutputDir)/Assemblies" />
  </Target>
</Project>
