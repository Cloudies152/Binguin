<Project Sdk="Microsoft.NET.Sdk">
  <!--
    冰鹅族构建配置（Visual Studio / Rider / dotnet 共用）。
    从模组根目录执行：dotnet build Source/Binguin/Binguin.Race.sln -c Release
    或执行 Source/build.ps1。两种方式都需要 .NET SDK。
    每位协作者复制 Binguin.local.props.example 为 Binguin.local.props，
    填写自己的游戏与 HAR 路径。只提交模板，不提交本机配置。
    详细说明见 Source/BUILDING.md。
  -->
  <PropertyGroup>
    <!-- 本机 HAR 1.6 的目标框架为 net48；使用 net472 会拒绝该引用（MSB3274）。
         程序集版本 4.0.0.0 不等于目标框架 net40。新增 API 仍需游戏内验证。 -->
    <TargetFramework>net48</TargetFramework>
    <!-- 保留 C# 5 以兼容已有源码；它不是 RimWorld 的硬性要求。 -->
    <LangVersion>5</LangVersion>
    <AssemblyName>Binguin</AssemblyName>
    <RootNamespace>Binguin</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 当前不生成 PDB；调试时可按需调整。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- 保留原有的文档与过时 API 警告抑制；程序集冲突警告不再隐藏。 -->
    <NoWarn>$(NoWarn);CS1591;CS0618</NoWarn>
  </PropertyGroup>

  <!-- 本机配置在默认目录推导之前导入；命令行 -p 属性优先。
       RimWorldDir 为游戏根目录；ManagedDir 可直接指定引用程序集目录。
       HarDir 为 HAR 根目录；HarAssemblyPath 可覆盖默认的 1.6 DLL 路径。
       各默认值只在属性为空时设置，避免覆盖协作者的本机配置。 -->
  <Import Project="Binguin.local.props" Condition="Exists('Binguin.local.props')" />
  <PropertyGroup>
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(RimWorldDir)' != ''">$(RimWorldDir)\RimWorldWin64_Data\Managed</ManagedDir>
    <HarAssemblyPath Condition="'$(HarAssemblyPath)' == '' and '$(HarDir)' != ''">$(HarDir)\1.6\Assemblies\AlienRace.dll</HarAssemblyPath>
    <CustomOutputDir Condition="'$(CustomOutputDir)' == ''">$(MSBuildProjectDirectory)\..\..\</CustomOutputDir>
    <GameModsDir Condition="'$(GameModsDir)' == ''">$(CustomOutputDir)</GameModsDir>
  </PropertyGroup>

  <!-- SDK 自动收集本项目及子目录的 .cs，并排除 bin/obj。
       游戏和 HAR 引用均设 Private=false，不复制进构建输出。 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AlienRace">
      <HintPath>$(HarAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Harmony 版本由公共项目统一；仅用于编译，游戏运行时由 Harmony 前置提供。 -->
    <PackageReference Include="Lib.Harmony" Version="2.4.1" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- 官方参考程序集包，避免每人另装 .NET Framework Developer Pack。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 在解析引用前检查全部文件；缺失时直接报路径错误，避免未解析引用被忽略。 -->
  <Target Name="CheckDependencyPaths" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ManagedDir)' == ''"
           Code="BINGUIN001" Text="请在 Binguin.local.props 中设置 RimWorldDir，或通过 -p:RimWorldDir 指定游戏目录（也可直接设置 ManagedDir）。" />
    <Error Condition="'$(HarAssemblyPath)' == ''"
           Code="BINGUIN002" Text="请在 Binguin.local.props 中设置 HarDir（HAR 模组根目录），或设置 HarAssemblyPath 指向 RimWorld 1.6 的 AlienRace.dll。" />
    <ItemGroup>
      <_RequiredDependency Include="@(Reference->'%(HintPath)')" />
    </ItemGroup>
    <Error Condition="!Exists('%(_RequiredDependency.Identity)')"
           Code="BINGUIN003" Text="找不到引用 DLL：%(_RequiredDependency.Identity)。请检查 Binguin.local.props 中的路径和依赖版本。" />
  </Target>

  <!-- 保留 SDK 默认 bin 输出，再仅将本项目 DLL 复制到模组 Assemblies。
       不扫描整个输出目录，避免把游戏、HAR 或 Harmony DLL 随模组发布。
       About.xml 已在模组目录中，无需复制给自己。 -->
  <Target Name="CopyToCustomDirectory" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CustomOutputDir)\Assemblies" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="已复制 $(TargetFileName) 到 $(CustomOutputDir)\Assemblies" />
  </Target>

  <!-- 可选：-p:DeployToGame=true 更新 GameModsDir 中的 DLL。目标须为已安装的完整模组目录。 -->
  <Target Name="DeployToGame" AfterTargets="CopyToCustomDirectory" Condition="'$(DeployToGame)' == 'true'">
    <Error Condition="!Exists('$(GameModsDir)')" Text="部署目录不存在：$(GameModsDir)。请设置 GameModsDir 为完整模组目录。" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameModsDir)\Assemblies" SkipUnchangedFiles="true" />
  </Target>
</Project>
