<?xml version="1.0" encoding="utf-8"?>
<!--
  历史实现记录：以下占位类型与启动期替换说明已废弃，当前使用 XML 直接声明。

  进阶钓鱼学（奥德赛 DLC 专属，2026-08-19 用户需求）：
  ★ 本文件夹（AdvancedFishing/）由 About.xml 的 loadFolders 门控：
    仅当奥德赛 DLC（Ludeon.RimWorld.Odyssey）激活时才加载本文件，
    因此可以放心引用原版 Fishing 研究 / Fish_* 鱼类 / FishingYield stat。
  ★ XML 零自定义类型原则不变：自定义 Comp / PlaceWorker / WorkGiver
    由 BinguinDefPatches 静态构造挂载（comps.Add / placeWorkers.Add /
    giverClass 替换）。
  ★ 三个新内容（用户定稿）：
    1. 蟹笼（Binguin_CrabTrap）：25 钢，放置在水域里，自动捕鱼——
       每天 6:00 / 12:00 / 18:00 / 24:00 各捕一次（每 15000 tick）；
       若放置在冰盖（地图无水域），则随机从当前任意水域捕捉。
    2. 打窝用具（Binguin_FishingBait）：50 钢 + 1 零部件，放置在水域里；
       可放入任意食物（营养值上限 5），每天消耗 1 营养值，
       以 50%/天 的速率加快该水域鱼群增长速度；每个水域最多放 2 个。
    3. 量产型钓竿（Binguin_FishingRod）：100 钢 + 3 零部件 + 20 铀；
       近战武器（竿柄 Poke 18 / 1.5s，竿头 Blunt 25 / 2.5s）；
       装备时钓鱼收获率 +50%（equippedStatOffsets FishingYield +0.5）。
  ★ 研究：Binguin_ResearchAdvancedFishing，600 点，
    前置 = 原版 Fishing + 增冰鹅鹅（Binguin_ResearchIcyPeaks）。
-->
<Defs>

  <!-- ============ 进阶钓鱼学（600 点，前置：原版钓鱼 + 增冰鹅鹅） ============
       解锁（反向引用）：蟹笼、打窝用具、量产型钓竿 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchAdvancedFishing</defName>
    <label>进阶钓鱼学</label>
    <description>冰鹅族的渔者世代与寒水为伴，如今更上层楼：他们学会编织蟹笼、调配饵料，并将铁与铀锻造成量产型钓竿。从此，寒原的每一条水域都成了他们的粮仓。（奥德赛 DLC 专属）</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>600</baseCost>
    <researchViewX>1.40</researchViewX>
    <researchViewY>2.40</researchViewY>
    <prerequisites>
      <li>Fishing</li>
      <li>Binguin_ResearchIcyPeaks</li>
    </prerequisites>
  </ResearchProjectDef>

  <!--
  历史实现记录：以下占位类型与启动期替换说明已废弃，当前使用 XML 直接声明。
 ============ 蟹笼（25 钢，任意位置自动捕鱼） ============
       每天 6:00 / 12:00 / 18:00 / 24:00 各捕一次（15000 tick 间隔）。
       ★ 2026-08-20 用户改定：任意位置（冰面/陆地/水域）可放置、自动运行，
         不依赖水域。放在水域中→捕该水域鱼群；放在水域外（冰盖冰面等）→
         全球鱼种随机。自定义 Comp（CompBinguinCrabTrap）与 PlaceWorker
         （放行全部格子）由 BinguinDefPatches 挂载。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_CrabTrap</defName>
    <label>蟹笼</label>
    <description>冰鹅族以寒铁编织的蟹笼，放置在水域中捕该水域的鱼群，或放置在冰面上自动捕获海洋鱼类。每天清晨六时、正午、黄昏六时与午夜各捕一次。</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <!-- ★ 性能优化（2026-08-20）：每 6h 捕鱼 → Rare（每 250 tick 判定一次） -->
    <tickerType>Rare</tickerType>
    <graphicData>
      <texPath>Things/Building/Binguin/CrabTrap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
      <shadowData>
        <volume>(1.2, 0.3, 1.2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>0</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0.6</fillPercent>
    <size>(1,1)</size>
    <!-- 水域地形不满足 BuildingBase 默认的 Light affordance：
         显式置空（同原版水车），放置条件完全交给 PlaceWorker -->
    <terrainAffordanceNeeded />
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>180</uiOrder>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.2</Flammability>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <costList>
      <Steel>25</Steel>
    </costList>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <researchPrerequisites>
      <li>Binguin_ResearchAdvancedFishing</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
      <comps>
      <li Class="Binguin.Feature.Fishing.CompProperties_BinguinCrabTrap, Binguin"><intervalTicks>15000</intervalTicks></li>
    </comps>
      <placeWorkers>
      <li>Binguin.Feature.Fishing.PlaceWorker_BinguinWaterArea, Binguin</li>
    </placeWorkers>
  </ThingDef>

  <!--
  历史实现记录：以下占位类型与启动期替换说明已废弃，当前使用 XML 直接声明。
 ============ 打窝用具（50 钢 + 1 零部件，放置在水域中） ============
       可放入任意食物（营养值上限 5）；每天消耗 1 营养值，
       以 50%/天 速率加快所在水域鱼群增长速度；每个水域最多放置 2 个。
       XML 用原版 CompProperties_ThingContainer 占位（零自定义类型），
       静态构造把 compClass 换成 CompBinguinFishingBait（继承
       CompThingContainer，innerContainer 直接可用）；投喂由自定义
       WorkGiverDef（Binguin_FillFishingBait，giverClass 静态构造替换）驱动。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_FishingBait</defName>
    <label>打窝用具</label>
    <description>冰鹅族渔民以寒铁与零件制成的饵料架。将任意食物放入其中（营养值上限 5），它便会每天消耗 0.5 营养值向所在水域撒饵，使鱼群以每天 50% 的速率加快增长。每个水域最多放置 2 个。</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Binguin/FishingBait</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
      <shadowData>
        <volume>(1.2, 0.3, 1.2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>0</pathCost>
    <blockWind>false</blockWind>
    <fillPercent>0.6</fillPercent>
    <size>(1,1)</size>
    <!-- 同蟹笼：水域放置，terrainAffordance 置空由 PlaceWorker 把关 -->
    <terrainAffordanceNeeded />
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>181</uiOrder>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.3</Flammability>
      <Cleanliness>-2</Cleanliness>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <!-- ★ 食物筛选（抄 Ideology 塑形仓 BiosculpterPod）：玩家选中建筑后
           右下角出现「存储」标签（ITab_Storage），可筛选允许投入的食物；
           fixedStorageSettings = 默认值来源，defaultStorageSettings = 玩家可改。
           默认 Foods 类目 = 一切食物（含鱼肉 Fish→MeatRaw→Foods）。 -->
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <filter>
          <categories>
            <li>Foods</li>
          </categories>
        </filter>
      </defaultStorageSettings>
    </building>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <comps>
      <!-- ★ 原版容器占位：stackLimit=5（数量兜底），compClass 由静态构造换成
           CompBinguinFishingBait（营养值容量 5.0 / 每天消耗 1.0 / 增速 50%） -->
      <li Class="CompProperties_ThingContainer">
        <compClass>Binguin.Feature.Fishing.CompBinguinFishingBait, Binguin</compClass>
        <stackLimit>5</stackLimit>
        <drawContainedThing>false</drawContainedThing>
      </li>
    </comps>
    <researchPrerequisites>
      <li>Binguin_ResearchAdvancedFishing</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
      <placeWorkers>
      <li>Binguin.Feature.Fishing.PlaceWorker_BinguinBaitLimit, Binguin</li>
    </placeWorkers>
  </ThingDef>

  <!-- 自定义类型和组件直接在下方 XML 声明；不再使用启动期占位替换。 -->
  <!-- ★ 不继承 HaulToBase（它定义在 Biotech 里，避免对 Biotech 的隐藏依赖），
       字段全部手写，只要求 Odyssey。 -->
  <WorkGiverDef>
    <defName>Binguin_FillFishingBait</defName>
    <label>fill fishing bait</label>
    <!-- ★ 占位 giverClass 必须用可实例化的具体类（WorkGiver_Scanner 是 abstract，
         会被 Worker 属性懒加载实例化而每帧报 MissingMethodException）！
         静态构造会替换为 WorkGiver_BinguinFillBait 并清 workerInt 缓存。 -->
    <giverClass>Binguin.Feature.Fishing.WorkGiver_BinguinFillBait, Binguin</giverClass>
    <workType>Hauling</workType>
    <verb>fill bait</verb>
    <gerund>filling bait</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <!-- scanThings=true：启用 PotentialWorkThingsGlobal 全图扫描打窝用具
         （否则用 ThingRequest 模式，我们的 WorkGiver 不会被调用） -->
    <scanThings>true</scanThings>
    <!-- 比普通搬运（90）低：只在空闲时投喂，不抢占主线搬运 -->
    <priorityInType>50</priorityInType>
  </WorkGiverDef></Defs>
