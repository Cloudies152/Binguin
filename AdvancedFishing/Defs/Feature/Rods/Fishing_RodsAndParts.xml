  <!--
  历史实现记录：以下占位类型与启动期替换说明已废弃，当前使用 XML 直接声明。
 ============ 高级钓竿技能（AbilityDef，Bladelink 式：装备时加给 pawn） ============
       ★ 2026-08-19 用户反馈：鱼竿必须保持近战武器（verbs 会让武器变远程！）
       → 技能走 Ability 系统：装备（Notify_Equipped）→ pawn.abilities.GainAbility
       → 命令栏显示能力按钮（AbilityTracker.GetGizmos）；
       效果 CompAbilityEffect 由静态构造挂载（XML 零自定义类型）。 -->
  <AbilityDef>
    <defName>Binguin_AbilityPierce</defName>
    <label>穿刺</label>
    <description>对前方 10 格内所有敌人造成 200% 于武器面板的伤害。冷却 10 秒。</description>
    <cooldownTicksRange>600~600</cooldownTicksRange>
    <!-- ★★ 2026-10 用户需求：瞄准改成「继承 Verb 的组件」。
         ⇒ ① `verbClass` 指向自定义的 `Verb_BinguinPierce`
              （继承 `Verb_CastAbility`，override `DrawHighlight`：
               画【施法范围圈】（原版白色那圈，最大射程）
               + 【施法者 → 准星】的一条直线，
               并把沿线的每一格整格高亮 = 这一发实际命中的格）。
               挂载链路（rw16 反编译实证）：
                 `VerbTracker.InitVerbsFromZero()` 用
                   `Activator.CreateInstance(verbProperties.verbClass)` 造 Verb；
                 `Ability.Initialize()` 里
                   `if (VerbTracker.PrimaryVerb is IAbilityVerb av) av.Ability = this;`
          ⇒ ② 不再写 `gizmoClass`：回到原版 `Command_Ability`
              （`AbilityDef.gizmoClass` 默认值就是它，IL 实证），
              它的 `ProcessInput` 会自己
                `Find.Targeter.BeginTargeting(ability.verb)`，
              而 `Targeter.TargeterUpdate()` 每帧调
                `verb.DrawHighlight(CurrentTargetUnderMouse(true))`
              —— 预览由 verb 负责，所以原来那套
              「自定义 gizmoClass + GameComponent 每帧画」已停用
              （`Command_BinguinAbility.cs` 里整段注释保留）。
          ⇒ ③ `canTargetPawns` 保持 **true** ⇒ 准星能框住 pawn；
              `canTargetLocations` 也保持 true ⇒ 地板照样能点，两种都行。 -->
    <verbProperties>
      <verbClass>Binguin.Feature.Rods.Verb_BinguinPierce, Binguin</verbClass>
      <range>10</range>
      <warmupTime>0.2</warmupTime>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>
      <comps>
      <li><compClass>Binguin.Feature.Rods.CompAbilityEffect_BinguinPierce, Binguin</compClass></li>
    </comps>
  </AbilityDef>

