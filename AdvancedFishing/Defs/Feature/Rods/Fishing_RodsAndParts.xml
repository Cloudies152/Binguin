  <!-- ============ 高级钓竿（2 种竿头类型；配件组合属性由 CompBinguinRod 动态计算） ============
       合成 = 装配台自定义对话框（消耗 竿身+竿头+鱼钩+鱼饵，按材质精确选择）。
       动态属性：伤害/穿甲 = tool 基础 × pawn.MeleeWeapon_DamageMultiplier（StatPart）
                  冷却 = tool 基础 × pawn.MeleeWeapon_CooldownMultiplier（StatPart）
                  耐久 = def 基础 × StatPart（鱼钩材质 MaxHitPoints 乘数） -->
  <ThingDef ParentName="BaseWeapon">
    <defName>Binguin_AdvancedRod_Blade</defName>
    <label>高级钓竿（刀制）</label>
    <description>冰鹅族以配件组装的定制钓竿：刀制竿头带来割与刺的双重打击。伤害与冷却随竿身、竿头与鱼钩的材质与类型变化，鱼饵还提供额外增益。</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/Binguin/AdvancedRodBlade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.1</uiIconScale>
