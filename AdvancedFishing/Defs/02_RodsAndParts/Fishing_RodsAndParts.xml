<?xml version="1.0" encoding="utf-8"?>
<!--
  高级钓鱼学 —— 钓竿制作系统（2026-08-19 用户设计文档：高级钓鱼学.md）
  ★ 本文件在 AdvancedFishing/ 文件夹（Odyssey 门控，LoadFolders.xml）
  ★ XML 零自定义类型原则：自定义 Comp/ThoughtWorker/StatPart 由
    BinguinDefPatches 静态构造挂载。
  ★ 核心设计（防踩坑记录，详见交接文档）：
    - 配件 = stuff 物品（costStuffCount + stuffCategories Metallic +
      内嵌 recipeMaker（本 def 无父类 recipeMaker → 不产生 recipeUsers 追加问题）），
      制作时玩家用原版材质选择器选金属（铁/玻璃钢/铀/银/金）→ 材质信息存 stuff。
    - 合成 = 装配台自定义对话框（原版配方筛选无法按材质区分配件——用户点名问题），
      精确选择仓库中的特定材质配件。
    - 动态属性 = 全部走原版 pawn stat + StatPart_BinguinRod（静态构造注册到
      MeleeWeapon_DamageMultiplier / MeleeWeapon_CooldownMultiplier / MoveSpeed /
      ToxicResistance / Immunity / InjuryHealingFactor / MaxHitPoints）：
      伤害&穿甲 = tool.power/armorPen × pawn.MeleeWeapon_DamageMultiplier（原版结算）
      冷却 = tool.cooldown × pawn.MeleeWeapon_CooldownMultiplier（原版结算）
      材质加成数值直接读原版 stuff 乘数（铀 BluntDamageMultiplier=1.5、
      玻璃钢 MeleeWeapon_CooldownMultiplier=0.8 —— 与用户设计文档示例完全一致）
    - 鱼饵 = 自定义对话框制作（效果由消耗食物决定，最多 2 种），comp 存档效果。
-->
<Defs>

  <!-- ============ 高级钓鱼学（3600 点，前置：进阶钓鱼学） ============
       解锁（反向引用）：钓竿装配台 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchMasterFishing</defName>
    <label>高级钓鱼学</label>
    <description>冰鹅族的渔者已将垂钓化作一门工程学：钓竿装配台、可替换的竿身与竿头、直弯双钩，以及以食物调制的饵料——每一根钓竿，都是量身打造的艺术品……但是，怎么是用来打人的？</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>3600</baseCost>
    <!-- ★ 2026-09 用户要求：本科技必须在【高级研究台】上研究 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>2.80</researchViewX>
    <researchViewY>2.40</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchAdvancedFishing</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 终极钓鱼学（2026-10-06 用户需求）============
       用户规格：「需要研究终极钓鱼学，前置是高级钓鱼学，需要高级研究台和多远分析仪」。
       · 前置 = 高级钓鱼学（Binguin_ResearchMasterFishing）
       · 工作台 = 高级研究台（HiTechResearchBench）
       · 设施   = 多元分析仪（MultiAnalyzer）
       研究完成才能制作尚方宝剑（见文件末尾的 Recipe_Binguin_VoidSwordFish）。 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchUltimateFishing</defName>
    <label>终极钓鱼学</label>
    <description>冰鹅族的渔者终于触及垂钓之道的尽头：他们发现，把寒原上每一条鱼的形与意都收进一柄剑里，便能唤出「天顶鱼斩」——十四条鱼的虚影自天顶轮番斩落。传说中，唯有将鱼竿和身体合二为一者才配执此剑。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Spacer</techLevel>
    <baseCost>5000</baseCost>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>4.20</researchViewX>
    <researchViewY>2.40</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchMasterFishing</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 钓竿装配台（3 格，200钢+200玻璃钢+4高级零部件+8零部件） ============
       制作钓竿配件（stuff 材质可选）+ 自定义对话框合成最终钓竿 / 制作鱼饵。 -->
  <!-- ★ 用 BenchBase 父类（原版工作台基类：ReportWorkSpeed comp、workshop 房间判定），
       加 ITab_Bills 制作清单 → 殖民者像用机工台一样制作配件（用户 2026-08-19 反馈） -->
  <ThingDef ParentName="BenchBase">
    <defName>Binguin_RodAssemblyTable</defName>
    <label>钓竿装配台</label>
    <description>冰鹅族工程渔者的工作台：以铁与玻璃钢打造，用于制作钓竿配件（竿身、竿头、鱼钩），并将选定的配件与鱼饵组装成独一无二的高级钓竿。</description>
    <thingClass>Building_WorkTable</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Binguin/RodAssemblyTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.2,2.2)</drawSize>
      <shadowData>
        <volume>(3.2, 0.4, 2.2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.6</fillPercent>
    <size>(3,1)</size>
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>182</uiOrder>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>250</Mass>
      <Flammability>0.2</Flammability>
      <Cleanliness>-5</Cleanliness>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <Plasteel>200</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>Binguin_ResearchMasterFishing</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

  <!-- ============ 钓竿（未完成）· 可搬运半成品（2026-10-06 用户需求）============
       用户需求原文：「应该是搬运后会变成一个 钓竿（未完成） 这样可以让殖民者不用一次干完」
       → 追问确认：**可搬运的半成品，装配进度跟着物品走**。

       设计：4 件配件搬到位后生成这件物品，4 件配件由它的 comp 容器保管
       （`CompBinguinUnfinishedRod : RimWorld.CompThingContainer`），
       已投入的工作量也记在它身上 ⇒ 中途被打断/换人/搬走都能接着干。

       ★ 这里**不写任何自定义类型**（本环境硬性要求）：`thingClass` 用原版
         `ThingWithComps`，compClass 由 `BinguinDefPatches` 静态构造挂上去。
       ★ 故意**不写 recipeMaker**（它不可制作）。
         ⚠ 但为了绝对安全，仍然显式写 `<recipeMaker IsNull="true" />`：
         本文件的其它 def 也可能带 recipeMaker，而原版
         `RecipeDefGenerator` 只要 `thingDef.recipeMaker != null` 就会自动生成
         一条 `Make_<defName>` 配方（IL 实证），撞名后会被 `DefDatabase.Add`
         改名（`defName + 随机数`），是上一轮踩过的真坑。
       ★ `tickerType` 用 Never：半成品不需要每 tick 逻辑（工作由 job 驱动）。 -->
  <ThingDef ParentName="UnfinishedBase">
    <defName>Binguin_UnfinishedRod</defName>
    <label>钓竿（未完成）</label>
    <description>一根装了一半的钓竿。配件已经装上去了，只差继续打磨装配——任何殖民者都可以接替工作。</description>
    <!-- ★ 覆盖 UnfinishedBase 的 thingClass（原版是 Verse.UnfinishedThing，
         那套绑定 bill 体系，本 mod 的装配没有 bill） -->
    <thingClass>ThingWithComps</thingClass>
    <!-- ★ 关掉原版 UnfinishedThing 专属标记，避免被原版各类判定当成 bill 半成品 -->
    <isUnfinishedThing>false</isUnfinishedThing>
    <graphicData>
      <!-- 复用原版"未完成武器"贴图（先能用；要专画再换） -->
      <texPath>Things/Item/Unfinished/UnfinishedWeapon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Never</tickerType>
    <recipeMaker IsNull="true" />
    <statBases>
      <Mass>3</Mass>
      <Flammability>0</Flammability>
      <Beauty>-4</Beauty>
      <SellPriceFactor>0.4</SellPriceFactor>
    </statBases>
    <!-- ★ 关掉继承来的 stuffCategories（`UnfinishedBase` 有 Metallic/Woody/Stony）：
         否则 `ThingMaker.MakeThing` 会报
           `MakeThing error: Binguin_UnfinishedRod is madeFromStuff but stuff=null. Assigning default.`
         （2026-10-06 实测）。半成品不需要另外选材质 —— 材质信息已经由它容器里
         **那 4 件配件本身**承载了，收尾时是从配件上读 `Stuff` 的。
         ★ 写法照抄原版同类 def：`UnfinishedGun` / `UnfinishedComponent` /
           `UnfinishedTechArmor` / `UnfinishedPack` … 都是用
           `<stuffCategories Inherit="false" />`（Core\Defs\ThingDefs_Items\Items_Unfinished.xml
           第 70/114/158/172/186 行等）。 -->
    <!-- ★★ 装配工作量 —— 直接挂原版配方（2026-10-06 用户需求：
         「我指的是你直接用原版制作的代码和显示，这样比较方便」）。
         这里就是**唯一的数值来源**：想调装配工作量只改这一个 `<workAmount>`。

         ★ 为什么这样写而不是在读代码里层层回退：原版取工作量的办法是
           `RecipeDef.WorkAmountTotal(thing)`，其 IL 为
             `if (workAmount >= 0) return workAmount;`
             `else return products[0].thingDef.GetStatValueAbstract(StatDefOf.WorkToMake, stuff);`
           ⇒ 写了 `workAmount` 就用它，否则才去看产物的 `WorkToMake`。
           所以给半成品配一个只带"做工参数"的 recipeMaker，就等价于
           "让装配也用原版配方的那套工作量/技能/速度设置"。

         ★ `workSpeedStat` / `workSkill` 与配件基类 `Binguin_RodPartBase` 保持一致
           （GeneralLaborSpeed / Crafting）⇒ 手工技能与工作速度加成照旧生效。 -->
    <recipeMaker>
      <workAmount>10000</workAmount>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <!-- ★★ 2026-10-09 修复 Config error（用户报的红字之一）：
           日志原文：`Config error in Binguin_UnfinishedRod:
                      has a recipeMaker but no costList or costStuffCount.`（报 2 次）
           出处（RimSage 实证）：`Verse/ThingDef.cs:1804` 的 `ConfigErrors`：
             `if (costList.NullOrEmpty() && costStuffCount <= 0 && recipeMaker != null)
                  yield return "has a recipeMaker but no costList or costStuffCount.";`
           ⇒ 只要 `recipeMaker != null` 就必须给一个代价字段。
           ★ 为什么删不掉 recipeMaker：`Comp_BinguinUnfinishedRod` 的
             `WorkAmountBase` / `Maker` 都是从 `def.recipeMaker` 读的
             （workAmount / workSpeedStat / workSkill）—— 删了整个装配工作量就没来源了。
           ★ 这个 1 单位代价**不会被扣**：装配流程不走 `RecipeDef`、不走 bill，
             工作量是 `WorkAmountBase` 直接读的；这条自动生成的
             `Make_Binguin_UnfinishedRod` 配方也**没有 recipeUsers**，
             所以不会出现在任何工作台的清单里。
           ★ 同时注意 L165 那行 `<recipeMaker IsNull="true" />` 其实**是无效的**
             —— 被这里的 `<recipeMaker>` 覆盖了（这是我原来的误解，留着无害但别指望它）。 -->
      <costStuffCount>1</costStuffCount>
    </recipeMaker>
    <stuffCategories Inherit="false" />
    <researchPrerequisites>
      <li>Binguin_ResearchMasterFishing</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 配件基类（stuff 物品：材质在制作时选择） ============ -->
  <ThingDef Name="Binguin_RodPartBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <drawGUIOverlay>true</drawGUIOverlay>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <tickerType>Never</tickerType>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <statBases>
      <!-- ★ 修复 config 错误：必须 Mass（可搬运）、Flammability 0（useHitPoints=false
           时易燃会报错）、去掉 DeteriorationRate（无耐久不可腐烂） -->
      <Mass>0.5</Mass>
      <Flammability>0</Flammability>
      <Beauty>-2</Beauty>
      <SellPriceFactor>0.5</SellPriceFactor>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <!-- ★ stuff 制作（内嵌 recipeMaker）：本 def 无父类 recipeMaker →
         不会产生原版工作台 recipeUsers 追加问题；材质在制作时选择（铁/玻璃钢/铀…） -->
    <costStuffCount>1</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <recipeUsers>
        <li>Binguin_RodAssemblyTable</li>
      </recipeUsers>
    </recipeMaker>
    <researchPrerequisites>
      <li>Binguin_ResearchMasterFishing</li>
    </researchPrerequisites>
  </ThingDef>

