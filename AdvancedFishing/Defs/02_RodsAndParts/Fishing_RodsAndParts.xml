  <!-- ============ 鱼饵（自定义对话框制作，效果由消耗食物决定，最多 2 种） ============
       ★ 独立定义（不继承 RodPartBase）——否则会继承 recipeMaker，
         装配台制作清单里出现"制作鱼饵"（用户 2026-08-19 反馈） -->
  <ThingDef>
    <defName>Binguin_RodBait</defName>
