<?xml version="1.0" encoding="utf-8"?>
<!--
  自动加特林塔（2026-08-20 用户需求，参考原版自动加农炮 Turret_Autocannon）
  - 冰鹅族建筑（designationCategory=BinguinBuilding），占地 2x2（四格）
  - 解锁 = 原版研究 HeavyTurrets（label 自动加农炮）+ 冰鹅机加工
  - 耗电 150W；材料同原版自动加农炮：350 钢 + 40 玻璃钢 + 6 零部件
  - 供弹机制（用户规格）：炮塔内置钢铁弹仓，**2 铁 = 1 发**，
    容量 300 铁（150 发）——CompRefuelable(Steel) + verb consumeFuelPerShot=2
    + fuelMultiplier=1；殖民者开「搬运」自动补钢（原版 refuel 机制）
  - 属性：精度 .40/.40/.30/.30；弹 12 / 穿甲 0.22 / 弹速 88；
    20 连发、间隔 6 tick；冷却 3.5s；射程 32.9；最小范围 6；
    抑止 0.5（1.6 无抑止系统，仅注释）
  - 贴图借用原版：底座 TurretHeavy_Base / 炮管 TurretAutocannon_Top /
    菜单图标 TurretAutocannon_MenuIcon（后续可换自制）
-->
<Defs>

  <!-- ============ 自动加特林塔（2x2 重型炮塔） ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_Turret_Gatling</defName>
    <label>自动加特林塔</label>
    <description>冰鹅族以寒铁锻造的六管加特林炮塔：转管怒吼间倾泻 20 发连射的钢铁风暴。炮管需要以钢铁养护——每次射击磨损炮管，耐久耗尽需以钢铁重修炮管；虽然精度平平，密集弹雨足以撕碎正面之敌。</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>Things/Building/Security/TurretHeavy_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5, 1.5)</drawSize>
      <drawOffset>(0,0,-0.1)</drawOffset>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(1.5,0.35,1.4)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/Security/TurretAutocannon_MenuIcon</uiIconPath>
    <uiIconScale>0.95</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <statBases>
      <MaxHitPoints>380</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToBuild>15000</WorkToBuild>
      <Mass>100</Mass>
      <Beauty>-20</Beauty>
      <ShootingAccuracyTurret>0.94</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>BinguinBuilding</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <costList>
      <Steel>350</Steel>
      <Plasteel>40</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>Binguin_Gun_GatlingTurret</turretGunDef>
      <turretBurstCooldownTime>3.5</turretBurstCooldownTime>
      <turretTopDrawSize>2.7</turretTopDrawSize>
      <turretTopOffset>(0, 0.05)</turretTopOffset>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>5.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <!-- ★ 炮管耐久（用户 2026-08-20 v3：显示与原版自动加农炮一致——
           以钢铁养护炮管，0.5 铁 = 1 耐久，满耐久 150 = 300 发；
           建造完成即满耐久；殖民者搬运自动补钢） -->
      <li Class="CompProperties_Refuelable">
        <fuelLabel>更换炮管前剩余射击数</fuelLabel>
        <fuelGizmoLabel>炮管耐久</fuelGizmoLabel>
        <outOfFuelMessage>需要更换炮管</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Steel</li></thingDefs></fuelFilter>
        <fuelCapacity>150</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
    </comps>
    <researchPrerequisites>
      <li>HeavyTurrets</li>
      <li>Binguin_ResearchMachining</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 加特林炮管（自动加特林塔的武器） ============ -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>Binguin_Gun_GatlingTurret</defName>
    <label>加特林炮管</label>
    <description>六管加特林炮管，装于炮塔上以极速连射。</description>
    <graphicData>
      <texPath>Things/Building/Security/TurretAutocannon_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.40</AccuracyTouch>
      <AccuracyShort>0.40</AccuracyShort>
      <AccuracyMedium>0.30</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>Binguin_Bullet_Gatling</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <minRange>6</minRange>
        <range>32.9</range>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <burstShotCount>20</burstShotCount>
        <soundCast>Shot_Autocannon</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <!-- ★ 每发消耗 0.5 铁（弹仓 150 铁 = 300 发，用户 2026-08-20 v2） -->
        <consumeFuelPerShot>0.5</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>

  <!-- ============ 加特林弹（12 伤 / 穿甲 22% / 弹速 88） ============ -->
  <ThingDef ParentName="BaseBullet">
    <defName>Binguin_Bullet_Gatling</defName>
    <label>加特林弹</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <armorPenetrationBase>0.22</armorPenetrationBase>
      <speed>88</speed>
    </projectile>
  </ThingDef>

  <!-- ============================================================================
       小型自动霰弹发射塔（2026-09 用户需求）
       蓝本 = 原版【小型自动机枪塔 Turret_MiniTurret】，差异如下：
         · 耐久 100 -> 120（+20）；仍然是 stuffable（Metallic，costStuffCount 30），
           所以实际耐久 = 120 × 材料系数（钢 ×1.0 / 玻璃钢 ×2.8 / 铀 ×2.5 …）。
           用户原话："耐久可以高20点（可根据材料提高）"。
         · 弹仓 60 钢铁，**每颗子弹消耗 2 铁** → 一梭子（连射 2）4 铁，满弹仓 30 发。
           实现 = <consumeFuelPerShot>2</consumeFuelPerShot> + CompProperties_Refuelable
           （与本 MOD 加特林塔同款机制，那套已经实测能跑）。
         · 武器换成霰弹：15 伤 / 连发 2 / 穿甲 12% / 瞄准 0.4s / 冷却 3s /
           射程 12.9 / 弹速 55 / 抑止 2。
         · ★ ShootingAccuracyTurret 用 1.0（原版是 0.96）——这个 stat 是
           炮塔的"射击精度系数"，会乘到武器自身精度上。设成 1.0 才能让
           下面 Gun 里写的 80/80/70/55 就是玩家实际看到的最终精度。
       前置（用户指定）：冰鹅机加工 + 原版自动机枪塔（GunTurrets）。
       ============================================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_Turret_Shotgun</defName>
    <label>小型自动霰弹发射塔</label>
    <description>冰鹅族把霰弹枪塞进了自动机枪塔的壳子里。射程短得可怜，但只要敌人踏进射程，两管霰弹就会糊他一脸——不需要瞄准手，也不需要怜悯。</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.27,0.25,0.27)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/Security/TurretMini_MenuIcon</uiIconPath>
    <uiIconScale>0.90</uiIconScale>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>8</Mass>
      <Beauty>-20</Beauty>
      <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <!-- ★ 弹仓：60 钢铁；每颗子弹 2 铁（见 Gun 里的 consumeFuelPerShot） -->
      <li Class="CompProperties_Refuelable">
        <fuelLabel>剩余弹药</fuelLabel>
        <fuelGizmoLabel>弹仓</fuelGizmoLabel>
        <outOfFuelMessage>弹药耗尽，需要钢铁</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Steel</li></thingDefs></fuelFilter>
        <fuelCapacity>60</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <hasTooltip>true</hasTooltip>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>30</costStuffCount>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>BinguinBuilding</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <building>
      <combatPower>45</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>Binguin_Gun_ShotgunTurret</turretGunDef>
      <turretBurstCooldownTime>3</turretBurstCooldownTime>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Binguin_ResearchMachining</li>
      <li>GunTurrets</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 迷你霰弹枪（小型自动霰弹发射塔的武器） ============
       精度 贴近 80% / 近 80% / 中 70% / 远 55% —— 因为炮塔的
       ShootingAccuracyTurret 设成了 1.0，这几个数就是最终精度。 -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>Binguin_Gun_ShotgunTurret</defName>
    <label>迷你霰弹枪</label>
    <description>两管霰弹，装在自动机枪塔的云台上。</description>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>8</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>Binguin_Bullet_ShotgunTurret</defaultProjectile>
        <warmupTime>0.4</warmupTime>
        <range>12.9</range>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <burstShotCount>2</burstShotCount>
        <soundCast>Shot_Shotgun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <!-- ★ 每颗子弹消耗 2 铁（弹仓 60 铁 = 30 发 = 15 梭） -->
        <consumeFuelPerShot>2</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>

  <!-- ============ 霰弹塔弹丸（15 伤 / 连发 2 / 穿甲 12% / 弹速 55 / 抑止 2） ============ -->
  <ThingDef ParentName="BaseBullet">
    <defName>Binguin_Bullet_ShotgunTurret</defName>
    <label>霰弹塔弹丸</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>15</damageAmountBase>
      <stoppingPower>2</stoppingPower>
      <armorPenetrationBase>0.12</armorPenetrationBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>

</Defs>
