<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     冰鹅族【演唱会灯光】两件建筑（2026-10-11 作者需求）

     作者原话：
       「先设计两个建筑：临时演唱会灯组（200钢铁6零部件，有个长钢架长9格，
         但占位置的只有两侧的两格，用于野外演唱会），演唱会灯组（30铁1零部件，
         占一格，不影响其他建筑，类似原版壁灯），这两个会影响演唱会效果，
         不过可以先不做效果曲线。」

     ★★ 两件建筑的定位
        · 临时灯组：**野外演唱会**用（可搬运、不依赖墙、覆盖范围大）
        · 吊装灯组：**室内/场地**用（挂墙、占 1 格、不影响地面）

     ★★ 关于「长钢架长 9 格，但占位置的只有两侧的两格」—— 【实现说明】
       作者补充确认：「就是占用两格，中间隔 7 格，只是显示上是连起来的」
       ⇒ 所以**不是**一个 9 格建筑，而是**两个各占 1 格**的灯柱，
         中间 7 格空着（可以走人、放东西），只是**贴图把它们画成连起来的钢架**。
       ⇒ 本文件按 `<size>(1,1)</size>` 各占 1 格实现。
       ⇒ 中间那根「连起来的钢架」属于**绘制层**，见下方 ⚠️ 待办。

     ⚠️⚠️ 待办（写代码时处理）
       ① 贴图未画：本文件引用的三张贴图**目前不存在**，游戏里会是占位方块：
            Things/Building/Joy/Binguin/ConcertLightRigTemp
            Things/Building/Joy/Binguin/ConcertLightRigTemp_MenuIcon
            Things/Building/Joy/Binguin/ConcertLight
            Things/Building/Joy/Binguin/ConcertLight_MenuIcon
          ⇒ 要登记到 `任务/参考/贴图需求总表.md`
       ② 「两个灯柱之间画一条钢架」需要**自写绘制**（原版没有这种"跨格连线"建筑）：
            思路：ThingClass 里找同行/同列、距离 ≤ 8 的同类灯柱，
                  用 `Graphic.Draw` 或 `GenDraw` 在中间格上补画钢架
            这部分**等美术贴图定了再做**（现在做没有贴图可画）
       ③ 「影响演唱会效果」的曲线**按作者要求先不做**，后续按灯的数量/覆盖率加成

     ★ 建造分类沿用本 mod 的「冰鹅建筑」（`BinguinBuilding`，见 TerrainDefs_Floors.xml）
     ★ 不加研究前置：本 mod 的乐器也都没有前置，灯光作为演出配套保持一致
     ★ 自定义类型直接写在 XML 里（keeptpa 2026-10 新规范，见 Source/XML_DEFS.md）
     ============================================================================ -->
<Defs>

  <!-- ══════════════════════════════════════════════════════════════════════
       ① 临时演唱会灯组 —— 野外用
          200 钢铁 + 6 零部件；占 1 格（成对放置，中间 7 格空着，贴图连起来）
       ══════════════════════════════════════════════════════════════════════ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_ConcertLightRigTemp</defName>
    <label>临时演唱会灯组</label>
    <description>野外演出用的临时灯架。两侧各立一根灯柱，中间用钢架连起来悬挂灯具。功率大、覆盖广，适合在空地上搭台；用完可以拆走。</description>

    <thingClass>Building</thingClass>
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>183</uiOrder>
    <rotatable>true</rotatable>

    <!-- ★ 占 1 格。成对放置，中间 7 格空着（作者确认"只是显示上连起来"） -->
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <blockWind>false</blockWind>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

    <graphicData>
      <texPath>Things/Building/Joy/Binguin/ConcertLightRigTemp</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconPath>Things/Building/Joy/Binguin/UI/ConcertLightRigTemp_MenuIcon</uiIconPath>
    <uiIconScale>1.2</uiIconScale>

    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>40</Mass>
      <Flammability>0.3</Flammability>
      <Beauty>-1</Beauty>
    </statBases>

    <constructEffect>ConstructMetal</constructEffect>

    <!-- 可搬运（临时性质 ⇒ 能拆下来带走） -->
    <minifiedDef>MinifiedThing</minifiedDef>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Glower">
        <glowRadius>14</glowRadius>
        <glowColor>(255,235,190,0)</glowColor>
      </li>
    </comps>

    <!-- ★ 2026-10-11 作者需求：归入「音乐」科技（前置 微电子基础） -->
    <researchPrerequisites>
      <li>Binguin_ResearchMusic</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ══════════════════════════════════════════════════════════════════════
       ② 演唱会灯组 —— 挂墙用（照抄原版 WallLamp 的范式）
          30 钢铁 + 1 零部件；占 1 格，挂墙上，不影响地面
       ══════════════════════════════════════════════════════════════════════ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_ConcertLight</defName>
    <label>演唱会灯组</label>
    <description>挂在墙上的演出灯具。体积小、不占地面，沿着墙排一圈就能把舞台照亮。</description>

    <thingClass>Building</thingClass>
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>184</uiOrder>
    <rotatable>true</rotatable>
    <overrideMinifiedRot>North</overrideMinifiedRot>

    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <!-- ★ 照抄原版壁灯：可通行 + 不需要地形支撑 + 零寻路代价 ⇒ 不挡路 -->
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <fillPercent>0.15</fillPercent>
    <blockWind>false</blockWind>

    <graphicData>
      <texPath>Things/Building/Joy/Binguin/ConcertLight</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <!-- ★ 壁灯的贴图偏移：让灯"贴"在墙上而不是压在格心 -->
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Joy/Binguin/UI/ConcertLight_MenuIcon</uiIconPath>
    <minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset>

    <costList>
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>

    <statBases>
      <WorkToBuild>350</WorkToBuild>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>3</Mass>
    </statBases>

    <constructEffect>ConstructMetal</constructEffect>
    <minifiedDef>MinifiedThing</minifiedDef>

    <building>
      <isEdifice>false</isEdifice>
      <!-- ★ 挂墙：照抄原版 WallLamp -->
      <isAttachment>true</isAttachment>
    </building>

    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
      <li>PlaceWorker_GlowRadius</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>30</basePowerConsumption>
        <shortCircuitInRain>false</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(255,235,190,0)</glowColor>
      </li>
    </comps>

    <!-- ★ 2026-10-11 作者需求：归入「音乐」科技（前置 微电子基础） -->
    <researchPrerequisites>
      <li>Binguin_ResearchMusic</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
