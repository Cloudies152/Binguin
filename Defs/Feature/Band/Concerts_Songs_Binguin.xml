<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
     冰鹅族【演唱会】· 曲目库（2026-10-11 作者需求）

     本 mod 已在用的 &lt;SoundDef&gt; 范式见 `Defs/Feature/IceCombat/Weapons_PenguinKick.xml`
     （`Binguin_Shot_GuGuGaGa`，指向 Sounds/GuGuGaGa.mp3）：
       SoundDef → subSounds → li → grains → li Class="AudioGrain_Clip" → clipPath
     ★ SoundDef **没有**顶层 clipPath 字段，必须走 grains；
       clipPath 写**不含扩展名**的相对路径（相对 Sounds/）。
     ★ mp3 / ogg / wav 都能用（RuntimeAudioClipLoader 按扩展名推断）。

     ══════ 给玩家：怎么塞自己的歌 ══════
       1) 把 .mp3 / .ogg / .wav 放进  Binguin_Race_Mod/Sounds/ConcertSongs/
       2) 在本文件照下面模板补两条（SoundDef + SongDef），改 defName / clipPath / label
       3) 一首歌只需一个 SongDef；同一场演唱会最多选 4 首

     ── 模板 ──
       <SoundDef>
         <defName>Binguin_SongClip_你的名字</defName>
         <context>MapOnly</context>
         <maxSimultaneous>1</maxSimultaneous>
         <subSounds>
           <li>
             <grains>
               <li Class="AudioGrain_Clip">
                 <clipPath>ConcertSongs/你的文件名</clipPath>
               </li>
             </grains>
             <onCamera>True</onCamera>
             <volumeRange>1~1</volumeRange>
             <pitchRange>1~1</pitchRange>
           </li>
         </subSounds>
       </SoundDef>

       <Binguin.Feature.Band.Binguin_SongDef>
         <defName>Binguin_Song_你的名字</defName>
         <label>显示名</label>
         <style>风格</style>
         <durationTicks>10000</durationTicks>          （1 小时 = 2500 tick）
         <moodOffset>5</moodOffset>
         <requiredArtisticLevel>4</requiredArtisticLevel>
         <soundDef>Binguin_SongClip_你的名字</soundDef>
       </Binguin.Feature.Band.Binguin_SongDef>

     ★ 技能：原版没有"音乐"技能，统一用 **Artistic（艺术）**。
     ============================================================================ -->
<Defs>

  <!-- ═══════════ MyGO!!!!! 四首（2026-10-11 作者提供）═══════════ -->

  <SoundDef>
    <defName>Binguin_SongClip_Mayoiuta</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>ConcertSongs/MyGO_Mayoiuta</clipPath></li>
        </grains>
        <onCamera>True</onCamera>
        <volumeRange>1~1</volumeRange>
        <pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>Binguin_SongClip_Utakotoba</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>ConcertSongs/MyGO_Utakotoba</clipPath></li>
        </grains>
        <onCamera>True</onCamera>
        <volumeRange>1~1</volumeRange>
        <pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>Binguin_SongClip_SilhouetteDance</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>ConcertSongs/MyGO_SilhouetteDance</clipPath></li>
        </grains>
        <onCamera>True</onCamera>
        <volumeRange>1~1</volumeRange>
        <pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>Binguin_SongClip_Harumikage</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip"><clipPath>ConcertSongs/MyGO_Harumikage</clipPath></li>
        </grains>
        <onCamera>True</onCamera>
        <volumeRange>1~1</volumeRange>
        <pitchRange>1~1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <Binguin.Feature.Band.Binguin_SongDef>
    <defName>Binguin_Song_Mayoiuta</defName>
    <label>迷星叫</label>
    <description>在迷途中喊出的歌。哪怕脚下没有路，也要把声音送到星星那里去。</description>
    <style>抒情</style>
    <durationTicks>10000</durationTicks>
    <moodOffset>6</moodOffset>
    <requiredArtisticLevel>4</requiredArtisticLevel>
    <musicDef>Binguin_Music_Mayoiuta</musicDef>
    <soundDef>Binguin_SongClip_Mayoiuta</soundDef>
  </Binguin.Feature.Band.Binguin_SongDef>

  <Binguin.Feature.Band.Binguin_SongDef>
    <defName>Binguin_Song_Utakotoba</defName>
    <label>詩超絆</label>
    <description>把说不出口的话写成诗，再把诗唱成羁绊。冰鹅族听完会安静很久。</description>
    <style>抒情</style>
    <durationTicks>10000</durationTicks>
    <moodOffset>7</moodOffset>
    <requiredArtisticLevel>4</requiredArtisticLevel>
    <musicDef>Binguin_Music_Utakotoba</musicDef>
    <soundDef>Binguin_SongClip_Utakotoba</soundDef>
  </Binguin.Feature.Band.Binguin_SongDef>

  <Binguin.Feature.Band.Binguin_SongDef>
    <defName>Binguin_Song_SilhouetteDance</defName>
    <label>影色舞</label>
    <description>影子也会跳舞。鼓点一起来，全场就没人坐得住了。</description>
    <style>激昂</style>
    <durationTicks>9000</durationTicks>
    <moodOffset>8</moodOffset>
    <requiredArtisticLevel>4</requiredArtisticLevel>
    <musicDef>Binguin_Music_SilhouetteDance</musicDef>
    <soundDef>Binguin_SongClip_SilhouetteDance</soundDef>
  </Binguin.Feature.Band.Binguin_SongDef>

  <Binguin.Feature.Band.Binguin_SongDef>
    <defName>Binguin_Song_Harumikage</defName>
    <label>春日影</label>
    <description>春天的影子落在雪原上。这首唱完，冰鹅族的观众会想起很久以前的家。</description>
    <style>民谣</style>
    <durationTicks>11000</durationTicks>
    <moodOffset>9</moodOffset>
    <requiredArtisticLevel>4</requiredArtisticLevel>
    <musicDef>Binguin_Music_Harumikage</musicDef>
    <soundDef>Binguin_SongClip_Harumikage</soundDef>
  </Binguin.Feature.Band.Binguin_SongDef>

  
  <!-- ══ ★ 2026-10-17：原版 SongDef（背景音乐）══
       作者要求：演唱会期间直接替换背景音乐，结束再换回来。
       开演时 Find.MusicManagerPlay.ForcePlaySong(songDef, true)，
       比我们自己播 SoundDef 可靠得多（1.7 的 one-shot 通道有静默闸门）。
       commonality=0 ⇒ 平时绝不会被随机选进背景音乐。 -->
  <SongDef>
    <defName>Binguin_Music_Mayoiuta</defName>
    <clipPath>ConcertSongs/MyGO_Mayoiuta</clipPath>
    <volume>0.55</volume>
    <commonality>0</commonality>
    <tense>false</tense>
  </SongDef>

  <SongDef>
    <defName>Binguin_Music_Utakotoba</defName>
    <clipPath>ConcertSongs/MyGO_Utakotoba</clipPath>
    <volume>0.55</volume>
    <commonality>0</commonality>
    <tense>false</tense>
  </SongDef>

  <SongDef>
    <defName>Binguin_Music_SilhouetteDance</defName>
    <clipPath>ConcertSongs/MyGO_SilhouetteDance</clipPath>
    <volume>0.55</volume>
    <commonality>0</commonality>
    <tense>false</tense>
  </SongDef>

  <SongDef>
    <defName>Binguin_Music_Harumikage</defName>
    <clipPath>ConcertSongs/MyGO_Harumikage</clipPath>
    <volume>0.55</volume>
    <commonality>0</commonality>
    <tense>false</tense>
  </SongDef>

</Defs>
