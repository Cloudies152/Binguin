<?xml version="1.0" encoding="utf-8"?>
<!--
  滑行冲刺的 job 与冰屑拖尾效果。
  JobDef：驱动 JobDriver_Slide 沿直线滑行（由企鹅滑板的 Verb_SlideDash 派发）。
  FleckDef：滑行时脚下的冰屑拖尾（FleckBase = 静态 fleck，FleckMaker.Static 使用）。
-->
<Defs>

  <JobDef>
    <defName>Binguin_Slide</defName>
    <!-- driverClass 由代码挂载（BinguinDefPatches），不在 XML 里引用自定义类型，
         避免 GenTypes 缓存问题导致 driver 为 null（滑行动画不跑） -->
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
  </JobDef>

  <FleckDef ParentName="FleckBase">
    <defName>Binguin_IceDust</defName>
    <graphicData>
      <texPath>Things/Fleck/Binguin/IceDust</texPath>
      <renderInstanced>true</renderInstanced>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.12</solidTime>
    <fadeOutTime>0.5</fadeOutTime>
  </FleckDef>

</Defs>
