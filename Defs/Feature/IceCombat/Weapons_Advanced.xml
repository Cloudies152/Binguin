<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族高级步枪 + 突袭冷冻武器（2026-08-20 用户需求）：
  ★ 研究「突袭冷冻武器」（Binguin_ResearchFrostAssault，前置：冰鹅机加工 +
    原版 PrecisionRifling 精密膛线）→ 【同时解锁】冰鹅族突击步枪与精确步枪
    （2026-08-20 用户改定：无独立自定义精准步枪研究——原规格中的「精准步枪」
    指原版 PrecisionRifling，作研究前置；两把都在冰鹅族机工台制作）。
  ★ 突袭冷冻武器机制（用户 2026-08-20 v2 改定）：
    - 命中冰爆% = 武器【面板伤害】× 1%（1 点面板伤害 = 1% 冰爆；
      品质越高面板伤害越高冰爆越猛——例：一般品质精确步枪 20 伤 →
      20%冰爆；传奇 30 伤 → 30%冰爆）
    - ★ 护甲不减冰爆：由 DamageWorker_BinguinIceBullet 在护甲结算前按
      面板伤害全额累积（弹头被护甲完全挡住也照样积累；用户 v2 规格）
    - 两把枪（突击/精确）弹药均带冰爆（都由「突袭冷冻武器」解锁）
    - 冰爆达到 100% → **纯随机**摧毁目标一个身体部位（含头部/核心，
      抽到致命部位即死亡；用户 v2 明确要求不排除头部），随后重置
      重新积累；**不弹消息**（HediffComp_BinguinIceBurst 挂载，静默）
  ★ 属性（用户规格逐项）：
    突击步枪：精度 贴近80/近70/中65/远60；弹伤16 穿甲26% 三连发(间隔10tick)
      瞄准0.9s 冷却1.6s 射程31.9 弹速70；抑止0.5（1.6 无抑止系统，仅注释）
    精确步枪：精度 贴近70/近70/中80/远90；弹伤20 穿甲46% 单发
      瞄准1.4s 冷却0.6s 射程46 弹速100；抑止2（同上注释）
    制作：45000 工作量 / 160钢+4零部件+1高级零部件 / 手工7 / 冰鹅族机工台
  ★ 贴图为占位（暂借 SMG/LeverRifle 贴图），后续可换正式美术。
-->
<Defs>

  <!-- ============ 冰爆弹损伤（继承原版 Bullet 弹伤） ============
       ★ 不再用 additionalHediffs（那是按实际结算伤害累积，护甲格挡会削减）！
       workerClass 由 BinguinDefPatches 静态替换为 DamageWorker_BinguinIceBullet：
       在护甲结算前按【武器面板伤害】累积冰爆（1 面板伤害 = 1% 严重度；
       弹头被护甲完全挡掉也照样全额积累，用户 2026-08-20 v2 规格）。 -->
  <DamageDef ParentName="Bullet">
    <defName>Binguin_IceBulletDamage</defName>
    <label>冰爆弹</label>
  </DamageDef>

  <!-- ============ 冰爆状态（0~100%，严重度 0~1） ============
       到 100% 触发随机摧毁部位（comp 由 BinguinDefPatches 静态构造挂载，
       触发后严重度 -1 重新积累） -->
  <HediffDef>
    <defName>Binguin_IceBurst</defName>
    <label>冰爆</label>
    <description>冰寒能量在体内凝集。达到 100% 时，寒能骤然冻结并崩碎一个身体部位。</description>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <makesAlert>false</makesAlert>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
  </HediffDef>

  <!-- ============ 冰鹅族突击步枪（研究：突袭冷冻武器） ============ -->
  <ThingDef ParentName="BaseGunWithQuality">
    <defName>Binguin_AssaultRifle</defName>
    <label>冰鹅族突击步枪</label>
    <description>冰鹅族工匠以寒铁与晶簇凝成的自动突击步枪。弹头内封着一缕冰爆寒能：每次命中都会在目标体内凝集与该发伤害等量的冰爆（1 伤害 = 1% 冰爆，品质越高越猛烈）——当冰爆蓄满 100%，寒能会骤然崩碎目标的一个身体部位。抑止能力 0.5。</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Binguin/AssaultRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>3.6</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.60</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <Plasteel>40</Plasteel>
      <Steel>60</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Binguin_Bullet_Assault</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <range>34.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>Gun</li>
      <li>IndustrialGunAdvanced</li>
      <li>BinguinMachined</li>
      <li>BinguinGunAssault</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <researchPrerequisites>
      <li>Binguin_ResearchFrostAssault</li>
    </researchPrerequisites>
  </ThingDef>

  <RecipeDef>
    <defName>Recipe_Binguin_AssaultRifle</defName>
    <label>制作冰鹅族突击步枪</label>
    <jobString>正在制作冰鹅族突击步枪……</jobString>
    <workAmount>30000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>160</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <Binguin_AssaultRifle>1</Binguin_AssaultRifle>
    </products>
    <recipeUsers>
      <li>Binguin_MachiningTable</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>7</Crafting>
    </skillRequirements>
    <researchPrerequisite>Binguin_ResearchFrostAssault</researchPrerequisite>
  </RecipeDef>

  <!-- 突击步枪弹：伤害 16，穿甲 26%，弹速 70；带冰爆附加 -->
  <ThingDef ParentName="BaseBullet">
    <defName>Binguin_Bullet_Assault</defName>
    <label>突击步枪子弹</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Binguin_IceBulletDamage</damageDef>
      <damageAmountBase>15</damageAmountBase>
      <armorPenetrationBase>0.33</armorPenetrationBase>
      <stoppingPower>0.5</stoppingPower>
      <speed>70</speed>
    </projectile>
  </ThingDef>

  <!-- ============ 冰鹅族精确步枪（研究：精准步枪） ============ -->
  <ThingDef ParentName="BaseGunWithQuality">
    <defName>Binguin_PrecisionRifle</defName>
    <label>冰鹅族精确步枪</label>
    <description>冰鹅族狙击手钟爱的长管精确步枪，寒木枪托上嵌着细碎冰晶。单发沉重、穿甲惊人——上千米外的猎物，也逃不过它的点名。</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Binguin/PrecisionRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>LongShots</li>
    </weaponClasses>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>4.4</Mass>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.80</AccuracyMedium>
      <AccuracyLong>0.90</AccuracyLong>
      <RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Binguin_Bullet_Precision</defaultProjectile>
        <warmupTime>1.4</warmupTime>
        <range>46</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_SniperRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>Gun</li>
      <li>IndustrialGunAdvanced</li>
      <li>LongShots</li>
      <li>BinguinGunPrecision</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <!-- ★ 2026-08-20 用户改定：两把冰鹅族步枪都由「突袭冷冻武器」解锁
         （无独立精准步枪研究；原版 PrecisionRifling 是研究的前置） -->
    <researchPrerequisites>
      <li>Binguin_ResearchFrostAssault</li>
    </researchPrerequisites>
  </ThingDef>

  <RecipeDef>
    <defName>Recipe_Binguin_PrecisionRifle</defName>
    <label>制作冰鹅族精确步枪</label>
    <jobString>正在制作冰鹅族精确步枪……</jobString>
    <workAmount>30000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>160</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <Binguin_PrecisionRifle>1</Binguin_PrecisionRifle>
    </products>
    <recipeUsers>
      <li>Binguin_MachiningTable</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>7</Crafting>
    </skillRequirements>
    <researchPrerequisite>Binguin_ResearchFrostAssault</researchPrerequisite>
  </RecipeDef>

  <!-- 精确步枪弹：伤害 20，穿甲 46%，弹速 100；同带冰爆（1 伤 = 1%） -->
  <ThingDef ParentName="BaseBullet">
    <defName>Binguin_Bullet_Precision</defName>
    <label>精确步枪子弹</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Binguin_IceBulletDamage</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <armorPenetrationBase>0.50</armorPenetrationBase>
      <stoppingPower>2</stoppingPower>
      <speed>100</speed>
    </projectile>
  </ThingDef>

</Defs>
