<?xml version="1.0" encoding="utf-8"?>
<!--
  滑行冲刺的 job 与冰屑拖尾效果。
  JobDef：驱动 JobDriver_Slide 沿直线滑行（由企鹅滑板的 Verb_SlideDash 派发）。
  FleckDef：滑行时脚下的冰屑拖尾（FleckBase = 静态 fleck，FleckMaker.Static 使用）。
-->
<Defs>

  <!-- 自定义类型和组件直接在下方 XML 声明；不再使用启动期占位替换。 -->
  <JobDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Binguin_AssembleRod</defName>
    <driverClass>Binguin.Feature.Rods.JobDriver_BinguinAssembleRod, Binguin</driverClass>
    <reportString>assembling a fishing rod.</reportString>
  </JobDef>

  <!-- 自定义类型和组件直接在下方 XML 声明；不再使用启动期占位替换。 -->
  <JobDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Binguin_WorkOnUnfinishedRod</defName>
    <driverClass>Binguin.Feature.Rods.JobDriver_BinguinWorkOnUnfinishedRod, Binguin</driverClass>
    <reportString>working on an unfinished fishing rod.</reportString>
  </JobDef></Defs>
