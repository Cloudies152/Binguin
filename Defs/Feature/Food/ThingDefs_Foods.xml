<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族食物：鱼干、芝士条（均由原版烹饪台制作）。
  鱼干：4 条鱼（Odyssey Fish_*）→ 8 根，每根营养 0.2
  芝士条：8 奶 → 8 根，每根营养 0.2
-->
<Defs>

  <!-- ============ 鱼干 ============ -->
  <ThingDef>
    <defName>Binguin_FishJerky</defName>
    <label>鱼干</label>
    <description>冰鹅族风干的鱼肉条，耐储存，咸香耐嚼，是寒原远行的干粮。</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Binguin/FishJerky</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <statBases>
      <Nutrition>0.2</Nutrition>
      <MarketValue>12</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
            <preferability>MealSimple</preferability>
    </ingestible>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>8</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <tradeTags>
      <li>Food</li>
    </tradeTags>
    <researchPrerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </researchPrerequisites>
  </ThingDef>

  <RecipeDef>
    <defName>Binguin_Recipe_FishJerky</defName>
    <label>制作鱼干</label>
    <jobString>正在制作鱼干……</jobString>
    <workAmount>120</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Fish_Salmon</li>
            <li>Fish_Bass</li>
            <li>Fish_Tilapia</li>
            <li>Fish_Cod</li>
            <li>Fish_Bluefish</li>
            <li>Fish_Guppy</li>
            <li>Fish_Frostfish</li>
            <li>Fish_Catfish</li>
            <li>Fish_Piranha</li>
            <li>Fish_Dogfish</li>
            <li>Fish_Marlin</li>
            <li>Fish_Tuna</li>
            <li>Fish_Flounder</li>
            <li>Fish_Toxfish</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <products>
      <Binguin_FishJerky>8</Binguin_FishJerky>
    </products>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
      <li>Campfire</li>
    </recipeUsers>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
      <researchPrerequisite>Binguin_ResearchIcyPeaks</researchPrerequisite>
  </RecipeDef>

  <!-- ============ 芝士条 ============ -->
  <ThingDef>
    <defName>Binguin_CheeseSticks</defName>
    <label>芝士条</label>
    <description>用奶源凝制的芝士棒，微咸回甘，营养扎实，是观测站里的常备小食。</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Binguin/CheeseSticks</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tickerType>Rare</tickerType>
    <statBases>
      <Nutrition>0.2</Nutrition>
      <MarketValue>14</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <ingestible>
      <foodType>Meal</foodType>
            <preferability>MealSimple</preferability>
    </ingestible>
    <thingCategories>
      <li>FoodMeals</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>8</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <tradeTags>
      <li>Food</li>
    </tradeTags>
    <researchPrerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </researchPrerequisites>
  </ThingDef>

  <RecipeDef>
    <defName>Binguin_Recipe_CheeseSticks</defName>
    <label>制作芝士条</label>
    <jobString>正在制作芝士条……</jobString>
    <workAmount>120</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milk</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
    </ingredients>
    <products>
      <Binguin_CheeseSticks>8</Binguin_CheeseSticks>
    </products>
    <recipeUsers>
      <li>ElectricStove</li>
      <li>FueledStove</li>
      <li>Campfire</li>
    </recipeUsers>
    <skillRequirements>
      <Cooking>4</Cooking>
    </skillRequirements>
      <researchPrerequisite>Binguin_ResearchIcyPeaks</researchPrerequisite>
  </RecipeDef>

</Defs>
