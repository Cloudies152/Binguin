<?xml version="1.0" encoding="utf-8"?>
<!--
  历史实现记录：以下占位类型与启动期替换说明已废弃，当前使用 XML 直接声明。
 ============================================================================
  冰鹅族飞天决战（2026-08-22 用户设计文档）
  · 研究「天问」：解锁大型信号发射器 + 飞船型发射仓（多元分析仪研究）
  · 大型信号发射器（露天 2×2）：与冰鹅族盟友时可"尝试联系母舰"，
    联系 13 天期间自定义袭击 15 波（4~24h 间隔，点数 ×1.2~1.4）
  · 联系成功 → 飞船型发射仓（4×4）可发射（至少 1 名殖民者在内）→ 结局
  ★ 机制代码见 Source/Mothership_Binguin.cs；comps/placeWorkers 由
    BinguinDefPatches 静态构造挂载（XML 零自定义类型）
============================================================================ -->
<Defs>

  <!-- ============ 天问（终极结局科技，6000 点） ============
       前置：大气控制（天气控制）+ 星空眺望（陨石操控）；高级研究台+多元分析仪
       解锁（反向引用）：冰鹅族大型信号发射器、冰鹅族飞船型发射仓 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchTianwen</defName>
    <label>天问</label>
    <description>冰鹅族世代观星的疑问终于凝成一问——"星空何在？" 冰鹅族观测者破译了星辰间的远古信标坐标，学会向深空发射巨量信号。殖民者将以此叩问苍穹：冰鹅族的母舰，正在群星之间等待回应。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Spacer</techLevel>
    <baseCost>6000</baseCost>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>2.80</researchViewX>
    <researchViewY>4.80</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchAtmosphere</li>
      <li>Binguin_ResearchStargazing</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 冰鹅族大型信号发射器（2×2，露天） ============
       材料：高级零部件4 + 零部件6 + 钢120 + 玻璃钢40；HP 900
       功能（CompBinguinSignalRelay，patch 挂载）：
       与冰鹅族盟友 → 「尝试联系冰鹅族母舰」→ 13 天联系期 + 袭击波 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_SignalRelay</defName>
    <label>冰鹅族大型信号发射器</label>
    <description>一座高耸的寒晶信标塔，以冰鹅族的观测科技向深空发射巨量信号。它必须在露天工作——穹顶会屏蔽来自群星的低语。与冰鹅族保持盟友关系，才能请它代为呼唤母舰。</description>
    <thingClass>Building</thingClass>
    <size>(2,2)</size>
    <graphicData>
      <texPath>Things/Building/Misc/DropBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>20</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.35</fillPercent>
    <rotatable>false</rotatable>
    <designationCategory>BinguinBuilding</designationCategory>
    <statBases>
      <MaxHitPoints>900</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>150</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <costList>
      <ComponentSpacer>4</ComponentSpacer>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Steel>120</Steel>
      <Plasteel>40</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>Binguin_ResearchTianwen</li>
    </researchPrerequisites>
      <comps>
      <li Class="Binguin.Feature.Diplomacy.CompProperties_BinguinSignalRelay, Binguin"></li>
    </comps>
      <placeWorkers>
      <li>Binguin.Feature.Diplomacy.PlaceWorker_BinguinOpenAir, Binguin</li>
    </placeWorkers>
  </ThingDef>

  <!-- ============ 冰鹅族飞船型发射仓（4×4） ============
       材料：高级零部件12 + 零部件20 + 钢400 + 铀60 + 燃料150；HP 600
       功能（CompBinguinShipCapsule，patch 挂载）：
       殖民者右键进入（舱内登记，job 由 patch 挂 driverClass）；
       母舰联系成功后选中建筑 → 「发射飞船」→ 结局 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_ShipCapsule</defName>
    <label>冰鹅族飞船型发射仓</label>
    <description>一座足以容纳殖民者的星间发射仓：冰鹅族母舰对接舱的仿制品。殖民者进入其中，当母舰确认航线后即可点火——送往母舰，或再次前往群星之间。</description>
    <!-- ★ thingClass = 原版 Building_Casket：自带内舱容器（TryAcceptThing/
         EjectContents/ContainedThing），殖民者收纳进舱随存档保存 -->
    <thingClass>Building_Casket</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <size>(4,4)</size>
    <graphicData>
      <texPath>Things/Special/DropPod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>60</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <designationCategory>BinguinBuilding</designationCategory>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>800</Mass>
      <Flammability>0.1</Flammability>
    </statBases>
    <costList>
      <ComponentSpacer>12</ComponentSpacer>
      <ComponentIndustrial>20</ComponentIndustrial>
      <Steel>400</Steel>
      <Uranium>60</Uranium>
      <Chemfuel>150</Chemfuel>
    </costList>
    <researchPrerequisites>
      <li>Binguin_ResearchTianwen</li>
    </researchPrerequisites>
      <comps>
      <li Class="Binguin.Feature.Diplomacy.CompProperties_BinguinShipCapsule, Binguin"></li>
    </comps>
  </ThingDef>

  <!-- 自定义类型和组件直接在下方 XML 声明；不再使用启动期占位替换。 -->
  <JobDef>
    <defName>Binguin_BoardCapsule</defName>
    <driverClass>Binguin.Feature.Diplomacy.JobDriver_BinguinBoardCapsule, Binguin</driverClass>
    <reportString>boarding the ship capsule.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
