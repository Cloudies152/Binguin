<?xml version="1.0" encoding="utf-8"?>
<!--
  鱼池水面地形：只作为「底色」使用。
  真正的动态水面由 Building_BinguinPond 在建筑层画帧动画（严格 2×2，不溢出）。
  这里不能用 waterBodyType / waterDepthShader：那会把鱼池注册成水体，
  引擎按水体边界渲染，范围会超出鱼池格。
-->
<Defs>

  <TerrainDef>
    <defName>Binguin_PondWater</defName>
    <label>鱼池水面</label>
    <description>鱼池里的静水。</description>
    <texturePath>Things/Building/Binguin/PondWaterTile</texturePath>
    <renderPrecedence>394</renderPrecedence>
    <edgeType>Hard</edgeType>
    <fertility>0</fertility>
    <natural>false</natural>
    <avoidWander>true</avoidWander>
    <holdSnowOrSand>false</holdSnowOrSand>
    <takeSplashes>true</takeSplashes>
    <extinguishesFire>true</extinguishesFire>
    <driesTo>Gravel</driesTo>
    <tags>
      <li>WaterFreshShallow</li>
    </tags>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

</Defs>
