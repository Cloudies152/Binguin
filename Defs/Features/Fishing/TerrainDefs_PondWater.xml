<?xml version="1.0" encoding="utf-8"?>
<!--
  鱼池水面地形（Waylith 1.7）
  ============================================================
  做法：
    · 贴图 / 深度着色器都跟原版 WaterShallow 一致（波纹、水深由引擎算）
    · customShader 换成我们自己的 TerrainWater 变体：
      把最后的“岸边噪声淡出”改成了 alpha = 1，
      所以水面不会向相邻格子淡化（不再溢出鱼池）
    · 带上 waterBodyType，引擎才会把水面参数（波纹场、反射贴图）传进着色器

  参考：
    · 原版注册方式：Data/Core/Defs/ShaderDefs/Shaders.Map.xml（ShaderDef）
    · RimWorld 1.7 模组更新指南：https://rimworldwiki.com/wiki/Modding_Tutorials
-->
<Defs>

  <TerrainDef>
    <defName>Binguin_PondWater</defName>
    <label>鱼池水面</label>
    <description>鱼池里的静水。</description>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <customShader>BinguinPondWaterType</customShader>
    <waterDepthShader>WaterDepth</waterDepthShader>
    <waterBodyType>Freshwater</waterBodyType>
    <renderPrecedence>394</renderPrecedence>
    <edgeType>Hard</edgeType>
    <fertility>0</fertility>
    <natural>false</natural>
    <avoidWander>true</avoidWander>
    <holdSnowOrSand>false</holdSnowOrSand>
    <takeSplashes>true</takeSplashes>
    <extinguishesFire>true</extinguishesFire>
    <driesTo>Gravel</driesTo>
    <tags>
      <li>Water</li>
      <li>WaterFreshShallow</li>
    </tags>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

</Defs>
