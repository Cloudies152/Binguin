<?xml version="1.0" encoding="utf-8"?>
<!--
  鱼池水面地形
  ============================================================
  为什么不用原版 WaterShallow：
    原版水地形带 <waterDepthShader>Map/WaterDepth</waterDepthShader>，
    会按水深渲染水体，并在相邻格子画一圈过渡岸线 ——
    放进 2×2 的鱼池里，视觉上水面会溢出池壁。

  这里用一张平铺水面贴图 + 不写着色器：
    · 水面严格限制在鱼池占的格子内，不会溢出
    · 贴图无缝平铺，多个鱼池拼起来是连续水面
    · 代价：静态水面（没有原版那种流动/深度变化）

  想换回原版水：把 FishPond 的 CompProperties_BinguinPondWater 里
  的 <terrainDef> 改成 WaterShallow 即可（会有岸线外溢）。
-->
<Defs>

  <TerrainDef>
    <defName>Binguin_PondWater</defName>
    <label>鱼池水面</label>
    <description>鱼池里的静水。</description>
    <texturePath>Things/Building/Binguin/PondWaterTile</texturePath>
    <renderPrecedence>394</renderPrecedence>
    <color>(1, 1, 1)</color>
    <pollutionColor>(1, 1, 1, 0.35)</pollutionColor>
    <edgeType>Hard</edgeType>
    <fertility>0</fertility>
    <natural>false</natural>
    <tags>
      <li>WaterFreshShallow</li>
    </tags>
    <affordances>
      <li>Bridgeable</li>
    </affordances>
  </TerrainDef>

</Defs>
