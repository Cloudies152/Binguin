<?xml version="1.0" encoding="utf-8"?>
<!--
  鱼池水面：自定义着色器试验
  ============================================================
  目的：用原版水面着色器（TerrainWater）的算法渲染动态水，
        但把「岸边噪声淡出」去掉，让水面严格限制在鱼池格内。

  第一阶段（当前文件）：先原样复制原版着色器，只为验证引擎是否加载
        mod 目录下的 Shaders/Map/*.glsl。
        验证通过后再改算法。
-->
<Defs>

  <ShaderTypeDef>
    <defName>BinguinPondWaterShader</defName>
    <shaderPath>Map/PondWater</shaderPath>
  </ShaderTypeDef>

</Defs>
