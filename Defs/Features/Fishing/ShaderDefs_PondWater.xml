<?xml version="1.0" encoding="utf-8"?>
<!--
  鱼池水面用的自定义着色器（Waylith 1.7 / ShaderDef）
  ============================================================
  · BinguinPondWater      表面水：复制原版 TerrainWater.frag.glsl，
                         去掉岸边噪声淡出（alpha = 1），水面不向邻格淡化
  · BinguinPondWaterDepth 深度/波纹：复制原版 WaterDepth.frag.glsl，
                         时间系数 ×0.3333（波纹速度降到原来的 1/3）

  文件在 Binguin_开发版/Shaders/Map/
-->
<Defs>

  <ShaderDef>
    <defName>BinguinPondWater</defName>
    <shaderProgram>
      <vertexShaderFileName>PondWater.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PondWater.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>2001</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_MainTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_AlphaAddTex</key>
          <value>Repeat</value>
        </li>
        <li>
          <key>_WaterReflectionTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

  <ShaderTypeDef>
    <defName>BinguinPondWaterType</defName>
    <shaderPath>BinguinPondWater</shaderPath>
  </ShaderTypeDef>

  <!-- 波纹速度 1/3 的深度着色器 -->
  <ShaderDef>
    <defName>BinguinPondWaterDepth</defName>
    <shaderProgram>
      <vertexShaderFileName>PondWaterDepth.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>PondWaterDepth.frag.glsl</fragmentShaderFileName>
      <flipTextureST>false</flipTextureST>
      <transparent>true</transparent>
      <depthTest>false</depthTest>
      <depthWrite>false</depthWrite>
      <cullMode>None</cullMode>
      <renderQueue>2000</renderQueue>
      <textureWrapOverrides>
        <li>
          <key>_RippleTex</key>
          <value>Repeat</value>
        </li>
      </textureWrapOverrides>
    </shaderProgram>
  </ShaderDef>

</Defs>
