<?xml version="1.0" encoding="utf-8"?>
<!--
  冰岩 / 冰岩砖：
  冰岩 = 采切石一体机在冰面采出的原岩（类似原版岩石块 ChunkGranite），
         可被切石桌（TableStonecutter）切制成冰岩砖（butcherProducts 机制，1 块 → 20 砖）。
  冰岩砖 = 原版石砖机制（换贴图 + 冰蓝色），不写自定义材料乘数，
          行为与数值全部沿用原版石材。
-->
<Defs>

  <!-- ============ 冰岩（原岩） ============ -->
  <ThingDef ParentName="ChunkRockBase">
    <defName>Binguin_IceRock</defName>
    <label>冰岩</label>
    <description>从冰层深处采出的岩块，冷冽剔透。可在切石桌上切成冰岩砖。</description>
    <graphicData>
      <texPath>Things/Item/Chunk/Binguin/IceRock</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>20</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <researchPrerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </researchPrerequisites>
    <butcherProducts>
      <Binguin_IceRockBrick>20</Binguin_IceRockBrick>
    </butcherProducts>
  </ThingDef>

  <!-- ============ 冰岩砖（建筑材料 stuff） ============ -->
  <ThingDef ParentName="StoneBlocksBase">
    <defName>Binguin_IceRockBrick</defName>
    <label>冰岩砖</label>
    <description>以冰岩切割而成的冰蓝色砖块。比寻常石材更轻盈，广受冰鹅族建筑师青睐。</description>
    <graphicData>
      <texPath>Things/Item/Binguin/IceRockBrick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>1.25</Mass>
    </statBases>
    <researchPrerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </researchPrerequisites>
    <!-- 用户 2026-11-16 决定：冰岩「不用材质」，就走原版石头的机制、只换贴图和外观色。
         因此这里不再写自定义 statFactors（原来那套利器/耐久/价值等材料乘数已移除），
         石块的行为、手感、数值全部沿用原版石材。 -->
    <stuffProps>
      <color>(130,160,200)</color>
      <stuffAdjective>冰岩</stuffAdjective>
    </stuffProps>
  </ThingDef>

</Defs>
