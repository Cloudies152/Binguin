<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族二期建筑（2026-08-19）：垃圾回收器 + 大气控制仪
  ★ 均由「环境保护」线解锁（垃圾回收 / 大气控制研究）
  ★ XML 零自定义类型：自定义 Comp（CompBinguinRecycler / CompBinguinWeather）
    由 BinguinDefPatches 静态构造代码挂载（见 Source）
-->
<Defs>

  <!-- ============ 冰鹅族垃圾回收器（参考原版 WastepackAtomizer 机制） ============
       2x1，100 铁 + 20 玻璃钢 + 4 零部件，200W。
       内部容器存有毒垃圾（Wastepack）最多 25 个；每 6000 tick（2.5 小时）
       自动回收 1 个 → 5 个 / 12 小时；每次产出 25-50 个随机矿物
       （铁40% / 玻璃钢20% / 铀20% / 金10% / 银10%）。
       殖民者自动搬运垃圾进来（原版 WorkGiver_HaulToAtomizer 按
       CompProperties_Atomizer.thingDef=Wastepack 匹配）。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_Recycler</defName>
    <label>冰鹅族垃圾回收器</label>
    <description>冰鹅族以钢铁打造的垃圾回收器，将有毒垃圾分解为可再生的矿物。插电后自动运转，可以回收铁、玻璃钢、铀、金或银。</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Binguin/Recycler</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1.2)</drawSize>
      <shadowData>
        <volume>(2, 0.3, 1.2)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.5</fillPercent>
    <size>(2,1)</size>
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>170</uiOrder>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.4</Flammability>
      <Cleanliness>-3</Cleanliness>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <!-- ★ 垃圾容器（原版原子化器机制）：殖民者用原版 WorkGiver_HaulToAtomizer
           自动搬运 Wastepack 进来；compClass 由 BinguinDefPatches 换成
           CompBinguinRecycler。ticksPerAtomize=20000 = 8 小时回收 1 个 -->
      <li Class="CompProperties_Atomizer">
        <thingDef>Wastepack</thingDef>
        <stackLimit>25</stackLimit>
        <ticksPerAtomize>20000</ticksPerAtomize>
        <drawContainedThing>false</drawContainedThing>
      </li>
    </comps>
    <researchPrerequisites>
      <li>Binguin_ResearchRecycling</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <!-- ============ 冰鹅族大气控制仪 ============
       2x2（占地 4 格），成本 高级零部件2 + 钢铁300 + 玻璃钢150 + 零部件6。
       ★ 2026-09 用户修订：改为「充能 24 小时才能使用一次，充满自动进入低耗能模式」，
         旧版"使用后 12 小时消耗 4000W"的爆发耗电已删除。
         · 充能中：700W（= 下面 basePowerConsumption），60000 tick = 24 小时充满一次
         · 充满：自动进入【低耗能模式】10W，此时随时可切一次天气
         · 用掉一次 → 立刻回到充能状态，重新充能 24 小时
         · 停电 / 关掉电源开关 → 充能暂停（不累积）
       选中建筑点天气按钮（晴/雨/暴风雨/雪/暴风雪）→ 立即切天气。 -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_AtmosphereController</defName>
    <label>冰鹅族大气控制仪</label>
    <description>冰鹅族以寒能驱动天穹的装置。通电后需以 700W 功率充能 24 小时方能操控一次天气；充满时会自动转入低耗能模式（10W），此时可将天气切换为晴、雨、暴风雨、雪或暴风雪。每次操控之后都要重新充能 24 小时，充能期间无法再次改变天象。</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Binguin/AtmosphereController</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.4,2.4)</drawSize>
      <shadowData>
        <volume>(2.4, 0.4, 2.4)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>0.6</fillPercent>
    <size>(2,2)</size>
    <designationCategory>BinguinBuilding</designationCategory>
    <uiOrder>175</uiOrder>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>120</Mass>
      <Flammability>0.3</Flammability>
      <Cleanliness>-4</Cleanliness>
    </statBases>
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <Steel>300</Steel>
      <Plasteel>150</Plasteel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>700</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <researchPrerequisites>
      <li>Binguin_ResearchAtmosphere</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>

</Defs>
