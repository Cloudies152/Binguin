<?xml version="1.0" encoding="utf-8"?>
<!--
  威灵装甲 + 威灵头盔（2026-08-20 用户需求，霰雪无垠解锁，机工台制作）
  ★ v3 修复（用户实测）：
    a) 材料显示修复：原「手动 RecipeDef + filter categories Metallic」错——
       Metallic 是材质类别不是 ThingCategoryDef（log：Failed to find
       ThingCategoryDef named Metallic → 配方材料区崩溃/空白）。改为
       【原版衣物范式】：def 上 stuffCategories + costStuffCount +
       recipeMaker（制作界面正常出现可选材料：钢/玻璃钢/铀等金属）。
       ★ 代价：原配方里的固定件（零部件/燃料/铀等）无法与可变材质共存
         （RimWorld 限制），已去除；护甲数值=材质贡献按玻璃钢基准
         （玻璃钢普通品质 利118/钝83/热89%、隔冷120/热20）。
    b) smeltable false（原 ApparelBase 继承 smeltable → 熔炼无产出报错）
    c) 装填/发射由 CompBinguinWillingCannon + JobDriver 搬运装填提供。
 威灵装甲（2026-09 材料）：任意金属 120 + 6 高级零部件 + 4 零部件
   + 加固炮管×1；基础 50/50/50、隔温 60/20；材质系数 护甲0.6/隔冷20/隔热5；
   Middle+Shell；躯干/颈/肩/臂/手/腿/脚；移速-0.3；装备 8s；35000 工作量；手工 9
 威灵头盔（2026-09 材料）：任意金属 40 + 2 高级零部件 + 1 零部件；
   全头覆盖 FullHead/Overhead；同款基础/系数；无移速惩罚；装备 2s；
   11667 工作量；手工 9
 弹舱/燃料/炮击（CompBinguinWillingCannon）：3 发迫击炮弹（mortar shell
   类均可，弹种由 projectileWhenLoaded 发射）+ 60 燃料（每发 10）；
   小人搬运装填（Binguin_WillingLoad job）；发射 30s CD + 1.5s 瞄准。
-->
<Defs>

  <!-- ============ 威灵装甲 ============ -->
  <!-- ★ v8（2026-08-21）：放弃原版 ApparelReloadable + verbs（v5-v7 三连败：
       原生命令/燃料条在这件 stuffable 装甲上不出现——修好 XML 二选一后依然
       无法发射）。炮击改为滑板同款【自绘命令】：三个按钮（装填炮弹/补充
       燃料/发射迫击炮）由 CompBinguinWillingCannon.CompGetWornGizmosExtra
       直接返回；发射 = Targeter 圈选落点 → 直接抛射（不经 verb）。
       comps/verbs 不再需要（Comp 由 BinguinDefPatches 挂载）。 -->
  <ThingDef ParentName="ApparelBase">
    <defName>Binguin_WillingArmor</defName>
    <label>威灵装甲</label>
    <description>霰雪无垠的战争造物：以金属为骨、燃料为弦的动力甲。护甲模块随材质增益，内置一门以加固炮管铸造的微型迫击炮——可装填 3 发迫击炮弹。走到哪里，炮火就到哪里。</description>
    <thingClass>Apparel</thingClass>
    <!-- ★ 2026-09 性能：删除 <tickerType>Normal</tickerType>。
         本件只有 CompBiocodable（原版，无 CompTick）与运行时挂载的
         CompBinguinWillingCannon（事件驱动 + GameComponent 每 600 tick 轮询，
         同样没有 CompTick）→ 逐 tick 被 tick manager 登记纯属浪费
         （IL 实证 CompBiocodable 未声明 CompTick）。不写该节点 = 继承
         ApparelBase 的 Never（对照原版 Apparel_AdvancedHelmet = Never）。 -->
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/ReconArmor/ReconArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <generateCommonality>1</generateCommonality>
    <recipeMaker>
      <workAmount>35000</workAmount>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <researchPrerequisite>Binguin_ResearchEndlessSnow</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>Binguin_MachiningTable</li>
      </recipeUsers>
      <displayPriority>120</displayPriority>
    </recipeMaker>
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <!-- ★ 2026-09 用户拍板材料：任意金属 120 + 6 高级零部件 + 4 零部件
         + 加固炮管 ×1（原版 ReinforcedBarrel）。stuffable + costList 固定件
         可共存（原版 Flak Helmet 先例）；炮管不建配方——贸易/任务获得。 -->
    <costList>
      <ReinforcedBarrel>1</ReinforcedBarrel>
      <ComponentSpacer>6</ComponentSpacer>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToMake>35000</WorkToMake>
      <MaxHitPoints>280</MaxHitPoints>
      <Mass>12</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
      <Insulation_Cold>60</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <!-- 材质系数：护甲 x60% / 隔冷 x2000% / 隔热 x500% -->
      <StuffEffectMultiplierArmor>0.6</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>20</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>8</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.3</MoveSpeed>
      <!-- ★ 2026-09 用户需求：威灵装甲 +31% 真空抗性（原版写法见 Biotech
           MechlordSuit；MayRequire 门控：未装 Odyssey 时不加载该行） -->
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.31</VacuumResistance>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Hands</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ReconArmor/ReconArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.8,0.9,1)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.55,0.75,0.95)</only>
        </li>
        <li>
          <weight>6</weight>
          <only>(0.35,0.5,0.7)</only>
        </li>
      </options>
    </colorGenerator>
    <comps>
      <li Class="CompProperties_Biocodable"/>
      <!-- ★ v8：reloadable/verbs 已全部移除（见文件头注释）。
           CompBinguinWillingCannon（3 弹舱 + 60 燃料自管 + 3 自绘命令）
           由 BinguinDefPatches 静态构造挂载，XML 零自定义类型。 -->
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
    <researchPrerequisites>
      <li>Binguin_ResearchEndlessSnow</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 威灵头盔（参考原版骑士头盔的全头覆盖） ============ -->
  <ThingDef ParentName="ApparelBase">
    <defName>Binguin_WillingHelmet</defName>
    <label>威灵头盔</label>
    <description>威灵装甲的头盔：全罩式晶面镜，护住整个头部。属性与装甲一脉相承，却轻巧得几乎感觉不到。</description>
    <thingClass>Apparel</thingClass>
    <techLevel>Spacer</techLevel>
    <smeltable>false</smeltable>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/ReconArmorHelmet/ReconHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.9, 0.9)</drawSize>
    </graphicData>
    <generateCommonality>1</generateCommonality>
    <recipeMaker>
      <workAmount>11667</workAmount>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <researchPrerequisite>Binguin_ResearchEndlessSnow</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>Binguin_MachiningTable</li>
      </recipeUsers>
      <displayPriority>120</displayPriority>
    </recipeMaker>
    <costStuffCount>40</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <!-- ★ 2026-09 用户拍板材料：任意金属 40 + 2 高级零部件 + 1 零部件 -->
    <costList>
      <ComponentSpacer>2</ComponentSpacer>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToMake>11667</WorkToMake>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0.3</Flammability>
      <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
      <Insulation_Cold>60</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <StuffEffectMultiplierArmor>0.6</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>20</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <thingCategories>
      <li>ArmorHeadgear</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ReconArmorHelmet/ReconHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.8,0.9,1,1)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.55,0.75,0.95,1)</only>
        </li>
        <li>
          <weight>6</weight>
          <only>(0.35,0.5,0.7,1)</only>
        </li>
      </options>
    </colorGenerator>
    <!-- ★ 2026-09 用户需求：威灵头盔 +68% 真空抗性（原版真空服头盔 0.69 同量级） -->
    <equippedStatOffsets>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.68</VacuumResistance>
    </equippedStatOffsets>
    <comps>
      <li Class="CompProperties_Biocodable"/>
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>
    <researchPrerequisites>
      <li>Binguin_ResearchEndlessSnow</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 威灵装填 job（小人真实搬运装填）
       殖民者从库存拿起炮弹/化合燃料 → 走到穿着威灵装甲的 pawn 旁 → 装填
       driverClass 由 BinguinDefPatches 静态构造挂载 -->
  <JobDef>
    <defName>Binguin_WillingLoad</defName>
    <reportString>loading ammunition.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- ============ 威灵炮击 job（v10：站定瞄准 1s 后开火）
       选点后派发给穿甲小人：原地站立转向落点 1 秒（原版射击 warmup 手感，
       期间移动/被命令打断 = 取消本次射击），瞄准完成后 ExecuteShot。
       casualInterruptible false：站定瞄准期间不会被杂务插队打断。
       driverClass 由 BinguinDefPatches 静态构造挂载 -->
  <JobDef>
    <defName>Binguin_WillingFire</defName>
    <reportString>firing the cannon.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- ★ v14（2026-08-21）：加固炮管（原版 ReinforcedBarrel）作为威灵
       装甲固定件 ×1，按用户意见【不添加制作配方】——只能通过贸易商队/
       轨道商人/任务奖励等原版途径获得。 -->

</Defs>
