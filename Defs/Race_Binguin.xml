<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族种族定义（Humanoid Alien Races 2.0 / RimWorld 1.6.4871）
  ★ 结构已对照 Miho 1.6（用户提供）与 原版 Human 定义（_vanilla_refs）逐字段核对：
    - 继承自 Human（HAR Getting-Started 推荐写法）：不覆盖 <race> 节点，
      完整继承人类的生命阶段/思维树/食谱/年龄曲线/手术配方/Anomaly 组件等。
    - HAR 专属设置放 <alienRace><generalSettings>（1.5+ 结构，不再是 comp）。
    - statBases 覆盖会整体替换父类列表，故按原版 Human 列全后再改舒适温度。
    - 1.6 枚举：intelligence 用 Humanlike（旧值 Human 已移除，Player.log 确认）。
-->
<Defs>
  <AlienRace.ThingDef_AlienRace ParentName="Human">
    <!-- ★★★ 2026-10-09【原版身形 / 头部 / 面部 版 v0.0.3】
         本版的小人**身体、头、脸全部借用原版贴图**；
         自绘的 Races/Binguin/{Body,Head,FA} 贴图与对应 def 均已移除。
         发型（Races/Binguin/Hair）保留。
         ⚠ 原版身形比自绘身形略矮（自绘是原版身高的 1.04 倍），
           自绘服饰是按自绘身形对齐的 ⇒ 穿自绘服饰时可能有轻微错位。 -->
    <defName>Binguin</defName>
    <label>冰鹅族</label>
    <description>来自寒冬星球的冰鹅族。</description>

    <!-- 继承 Human 的 statBases 并全量重列：仅修改舒适温度（寒原住民：极耐寒、略怕热） -->
    <statBases>
      <MarketValue>1750</MarketValue>
      <!-- ★ 2026-10-01 用户要求：4.6 → 4.7
           目的：吃到慢性子基因（原版 MoveSpeed_Slow）后正好 4.5，只比智人（4.6）慢一点点。
           验算：4.7 − 0.2 = 4.5 ✓   （改之前是 4.6 − 0.2 = 4.4）
           ⚠ 注意 MoveSpeed_Slow 是【固定 -0.2 偏移】，不是百分比 —— 详见 Genes_Binguin.xml 的注释。 -->
      <MoveSpeed>4.7</MoveSpeed>
      <!-- ★ 2026-10-01 用户要求：营养【储存上限】= 1.2
           （明确不是代谢/消耗速度 —— hungerRate 一个字没动）
           ★ 机制（IL 实证 RimWorld 1.6.4871）：原版并没有给 pawn 用
             「bodySize × lifeStage.foodMaxFactor」那套（那条分支在当前版本已不生效），
             实际取的是：Need_Food.get_MaxLevel → pawn.GetStatValue(StatDefOf.MaxNutrition)
             而 MaxNutrition 的 defaultBaseValue = 1 ⇒ 这里写 1.2 就是最直接的口径。
           ⇒ 效果：容量 ×1.2，吃饱后能撑的时间 ×1.2，但【消耗速度完全不变】。
           ⚠ 已知副作用（用户已确认要这个）：
             ① 饱食度阈值按比例算（Hungry / UrgentlyHungry 都是百分比），
                所以"饿"的绝对营养值也等比抬高（0.45 → 0.54）；
             ② MaxNutrition 的 <hideAtValue>1</hideAtValue> ⇒ 现在不等于 1 了，
                这个 stat 会开始显示在小人的属性面板里（原来隐藏）。 -->
      <MaxNutrition>1.2</MaxNutrition>
      <ComfyTemperatureMin>-45</ComfyTemperatureMin>
      <ComfyTemperatureMax>25</ComfyTemperatureMax>
      <LeatherAmount>75</LeatherAmount>
      <RoyalFavorValue>3</RoyalFavorValue>
      <Wildness>0.75</Wildness>
    </statBases>

    <alienRace>
      <generalSettings>
        <!-- 企鹅娘：约九成为女性（Miho 0.3 / Raven 0.1 均为验证写法） -->
        <maleGenderProbability>0.1</maleGenderProbability>
        <!-- 继承全部人类手术配方（义体、器官移植等），含其他 mod 间接添加的 -->
        <humanRecipeImport>true</humanRecipeImport>

        <alienPartGenerator>

          <!-- ============ 头部（2026-09 用户手绘：南 / 北 / 东） ============
               ★ Inherit="False" 必须写：不然会【继承父类 Human 的头型表】，
                 小人会随机长出一颗原版人头。
               ★ 头型定义见 Defs/Head_Binguin.xml；贴图
                 Textures/Races/Binguin/Head/BinguinHead_{south,north,east}.png；
                 生成脚本 Tools/Make-BinguinHeadTextures.py（素材在 贴图/头/）。 -->
          <headTypes Inherit="False">
            <li>Binguin_Head_Average</li>
          </headTypes>

          <!-- ============ 体型限制（2026-09 用户需求） ============
               冰鹅族只出现【女性 Female】和【纤细 Thin】两种成人体型。
               原来画的 男身形 素材已改名细身形，输出为 BinguinBody_Thin_*，挂到 Thin 上。
               Male / Hulk / Fat 一律不再出现；婴儿和小孩没画，先用原版贴图。

               ★★ 下面两个 default 字段的取值看着反直觉，但【必须这么写】——
                  来自 HAR 1.6 的 IL 实证（AlienRace.HarmonyPatches.CheckBodyType，
                  Gender 枚举 Male=1 / Female=2）：
                    · 男性 pawn → 从候选表里【移除 defaultFemaleBodyType】
                    · 女性 pawn → 从候选表里【移除 defaultMaleBodyType】
                  移除后如果当前体型不在候选表里，就从剩下的里面随机重抽。
                  所以候选表只有 [Female, Thin] 时：
                    Female 小人：移除 Thin  → 只剩 [Female] → 必定 Female
                    Male   小人：移除 Female → 只剩 [Thin]  → 必定 Thin
                  把这两个值对调或删掉，结果就会翻车（全变 Thin 或随机五五开）。
                  另：Baby/Child 会在上面这两步之前先被移出候选表，所以不影响成人。 -->
          <bodyTypes>
            <li>Female</li>
            <li>Thin</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">Baby</li>
            <li MayRequire="Ludeon.RimWorld.Biotech">Child</li>
          </bodyTypes>
          <defaultFemaleBodyType>Female</defaultFemaleBodyType>
          <defaultMaleBodyType>Thin</defaultMaleBodyType>
          <!-- 肤色通道：固定纯白 —— 保证每只冰鹅颜色完全一致，且与画稿一模一样
               ★ 2026-09 根因（IL 实证，别再改回去）：
                 (1) HAR 的 AlienComp.UpdateColors() 会把 skin 通道的 first 覆盖成
                     pawn.story.SkinColor；而 SkinColor → SkinColorBase 又被 HAR 的
                     HarmonyPatches.SkinColorHelper 重定向回本通道的 first。
                     即 first 是【每个小人各自随机抽一次】再被引用回去的。
                     原来写 ColorGenerator_Options 90/10 两档近白 →
                     每只冰鹅亮度都略有不同，这就是"肤色都不一样"的真正原因。
                 (2) 身体/头部贴图的染色取的是通道的 **second**，不是 first
                     （AlienRenderTreePatches.BodyGraphicForPrefix / HeadGraphicForPrefix
                       都传 SkinColor(pawn, false)，false 分支返回 second）。
                     second 不写默认是 Color.clear（alpha=0），必须显式给白。
                 (3) 写法照抄验证过的 HAR 种族 Rabbielike (workshop 1837246563)
                     GeneralRace.xml，它 skin 通道就是 first/second 双纯白。
               ★ 想让小人整体偏某个色调，改这里的 <color> 即可（白色=不染色）。 -->
          <colorChannels>
            <li>
              <name>skin</name>
              <first Class="ColorGenerator_Single">
                <color>(1.0, 1.0, 1.0)</color>
              </first>
              <!-- ★ second = colorTwo（身体/头部 GraphicRequest 的第 2 个颜色）。
                   必须也写白：原版在"玩家自定义肤色"时会切到 CutoutSkinColorOverride 着色器，
                   那条路会用到 colorTwo；而 skinColorOverride 基因一挂上，
                   pawn.story.SkinColorOverriden 就为 true → 正好走那条路。
                   写白后 color == colorTwo == 纯白，与原版「两者都等于 SkinColor」的不变量一致。 -->
              <second Class="ColorGenerator_Single">
                <color>(1.0, 1.0, 1.0)</color>
              </second>
            </li>
          </colorChannels>

          <!-- 鸟喙附加件：已按用户要求移除（2026-08-17）。
               如需恢复，参考《会话交接文档》§4.4 的 bodyAddons 约定与
               Tools\Make-BinguinPlaceholderTextures.ps1 生成的贴图。 -->
          <!-- ==================== 头部绘制参数（可调旋钮） ====================
               ★ headOffset：头部相对小人绘制点的偏移（单位=格）。默认 (0,0)，
                 也就是"原版头该在哪就在哪"（BodyTypeDef 自己的 headOffset 仍然生效：
                 Female (0.10,0.34) / Thin (0.09,0.34)）。
                 头看起来【偏上/偏下】就改这里的 y（正数=更高，0.05 ≈ 3 像素）。
               ★ customHeadDrawSize：头部整体缩放。默认 (1,1)。
                 ★★ 我们的身体是原版身高的 1.04 倍（Make-BinguinBodyTextures.py 的 SCALE），
                    所以头贴图生成时已经乘了 1.04（Make-BinguinHeadTextures.py 的 HEAD_SCALE），
                    这里保持 1 【不要再乘一次】，否则会放大 1.04²。
                    如果实测觉得头还是偏大/偏小，最省事的改法是调 HEAD_SCALE 重新生成贴图
                    （不用重画），其次才是改这里。 -->
          <headOffset>(0, 0)</headOffset>
          <customHeadDrawSize>(1, 1)</customHeadDrawSize>
          <customPortraitHeadDrawSize>(1, 1)</customPortraitHeadDrawSize>
        </alienPartGenerator>

        <!-- 种族基因（HAR 的 raceGenes：无论异种如何都带有的基因）
             原版引用 + 自定义基因（定义见 Genes_Binguin.xml） -->
        <raceGenes>
          <!-- 原版：耐寒 -->
          <li><defName>MinTemp_SmallDecrease</defName></li>
          <!-- 原版：惧热 -->
          <li><defName>MaxTemp_SmallDecrease</defName></li>
          <!-- 原版：种植才疏 -->
          <li><defName>AptitudePoor_Plants</defName></li>
          <!-- 原版：格斗才疏 -->
          <li><defName>AptitudePoor_Melee</defName></li>
          <!-- 原版：慢性子（slow runner，移速降低） -->
          <li><defName>MoveSpeed_Slow</defName></li>
          <!-- 原版：天性豁达（very happy，心情常驻高位） -->
          <li><defName>Mood_Sanguine</defName></li>
          <!-- 原版：极度冷静（dead calm，永不主动斗殴/狂暴） -->
          <li><defName>Aggression_DeadCalm</defName></li>
          <!-- ★ 自定义：纯白绒羽 —— 用 skinColorOverride 把肤色【硬性定死】为纯白。
               这是根治"每只冰鹅肤色都不一样"的关键：只改 colorChannels 治不了本，
               因为原版会在没有黑色素基因时【随机塞一个】进来（详见 Genes_Binguin.xml 注释）。 -->
          <li><defName>Binguin_Gene_PureWhiteSkin</defName></li>
          <!-- 自定义：高效研究（研究+20%，破译+30%） -->
          <li><defName>Binguin_Gene_EfficientResearch</defName></li>
          <!-- 自定义：快速滑冰 -->
          <li><defName>Binguin_Gene_Skating</defName></li>
          <!-- 自定义：鱼类爱好 -->
          <li><defName>Binguin_Gene_FishLover</defName></li>
          <!-- 自定义：机工高手 -->
          <li><defName>Binguin_Gene_MechExpert</defName></li>
          <!-- 自定义：娱乐至上（娱乐下降×110%） -->
          <li><defName>Binguin_Gene_RecreationLover</defName></li>
        </raceGenes>
      </generalSettings>

      <!-- ==================== 外观样式表（2026-09-24 新增：自绘头发） ====================
           ★ 作用：把冰鹅族的【可选发型】限定到我们自己的 BinguinHair 一组，
             原版几十种人类发型自动被排除 —— 从此不再需要"冰鹅一律秃头"那种硬补丁。
           ★ 语法照抄渡鸦族 ZuoYao_RavenRace 的 AlienRace_Raven.xml 第 583 行起的
             <styleSettings>（HAR 官方写法，已实证）。
           ★ BeardDef 关掉：企鹅没有胡子。
           ★ 配套的三处改动（缺一不可，详见《会话交接文档》第 93 条）：
             ① Defs/HairDefs_Binguin.xml 里的两个 HairDef（styleTags = BinguinHair）
             ② 本文件这里的 styleTagsOverride
             ③ Textures/Races/Binguin/Hair/ 下的贴图（Tools\Make-BinguinHairTextures.py 生成） -->
      <styleSettings>
        <li>
          <key>HairDef</key>
          <value>
            <hasStyle>true</hasStyle>
            <styleTagsOverride>
              <li>BinguinHair</li>
            </styleTagsOverride>
          </value>
        </li>
        <li>
          <key>BeardDef</key>
          <value>
            <hasStyle>false</hasStyle>
          </value>
        </li>
      </styleSettings>

      <!-- ==================== 身体贴图（2026-09 用户提供 女/细身形） ====================
           HAR 约定：<graphicPaths><body> 里的 <path> 是"默认身体贴图前缀"，
           <extendedGraphics> 里可以按 BodyTypeDef 逐个覆盖。
           路径不带方向后缀 —— Graphic_Multi 会自动去找 _south / _north / _east。
           （_west 缺失时自动镜像 _east，见 Textures\README.txt）

           ★★ 画布基准（2026-09 第三次修正【含真实脚底线】）：
              512×512 正方形，水平中心 x=256，【脚底线逐方向对齐原版】：
                  south y=441、north y=440、east y=442
              基准取自【美狐 Miho】，但必须【设 alpha 阈值 >= 32】再量 ——
              美狐那张图在 y=488 有一个 alpha=2 的抗锯齿杂点，直接 getbbox()
              会把底边算成 489，导致人物整体偏低 32px、偏高 12.6%
              （踩过，详见会话交接文档）。
              （2816826107\Cont\Textures\Miho\Body\Naked_Female_south.png，
                alpha>=32 实测 = 人物 111×261、脚底 y=441）
           ★ 第一次接的时候误用了 ZuoYao_RavenRace 的比例（1024 画布、人物仅 280 高 = 27%），
             游戏里明显偏小 —— 用户实测指出后改成美狐基准。
             **教训：不同 HAR 种族的画布比例【不通用】，要跟"你实际想对齐的那个种族"比。**
           ★ 生成脚本：Tools\Make-BinguinBodyTextures.py
             · 里面 SCALE 是"整体大小"旋钮（当前 1.04 = 比原版高 4%）：
               只缩人物高度、【脚底线不动】；改 SCALE 不用重画素材。
             · 改完身体尺寸后，自绘服饰必须跟着跑一次
               Tools\Align-BinguinApparelToBody.py（增量缩放，改 OLD_*/NEW_* 两个锚点）。 -->
      <graphicPaths>
        <!-- ★★★ 2026-09 修复（用户实测「小人依然用原版头部」的真正原因）：
             HAR 的头部贴图【不是】从 Core 的 HeadTypeDef.graphicPath 拿的，
             而是从 HAR 自己的 <graphicPaths><head> 拿的！
             IL 实证 AlienRace.AlienRenderTreePatches.HeadGraphicForPrefix：
                graphicPaths.head.GetPath(pawn, ref sharedIndex, headVariant, null)
                → GraphicDatabase.Get<Graphic_Multi>(path, ...)
             而 AlienRace.GraphicPaths 里有个常量 VANILLA_HEAD_PATH ——
             <head> 不写就【回退到原版人头贴图】，这正是我们之前的表现。
             （参照 ZuoYao_RavenRace：<head>Races/Raven/Head/Blank/RavenHead_Blank</head>，
              就是一个纯字符串节点，不是 <path> 子节点。）
             路径不带方向后缀，Graphic_Multi 自己找 _south/_north/_east；
             _west 缺失时自动镜像 _east。 -->
        <!-- ★★★ 2026-10-09【原版身形/脸版 v0.0.3】改造点 ①：头部改用**原版头型**
             原版 HeadTypeDef 的 graphicPath 形如
               Things/Pawn/Humanlike/Heads/Male/Male_Average_Normal
               Things/Pawn/Humanlike/Heads/Female/Female_Average_Normal
             这里填不带男女区分的 Average_Normal 作兜底；同时
             `Defs/Head_Binguin.xml` 已删除 ⇒ 头部走**原版头型随机选择**。 -->
        <head>
          <path>Things/Pawn/Humanlike/Heads/Male/Male_Average_Normal</path>
        </head>
        <body>
          <path>Things/Pawn/Humanlike/Bodies/Naked_Male</path>
          <extendedGraphics>
            <!-- 只保留实际会用到的 4 个体型（成人见上方 bodyTypes）。
                 Male / Hulk / Fat 已删除；万一存档里残留这些体型，会落到
                 <body><path> 的兜底（原版 Naked_Male），不会崩。
                 ★ 2026-09：原来的 男身形 素材已改名细身形，输出 BinguinBody_Thin_*。 -->
            <!-- ★★★ 改造点 ②：身形改用**原版身体贴图**
                 值直接抄原版 BodyTypeDef.bodyNakedGraphicPath：
                   Female → Things/Pawn/Humanlike/Bodies/Naked_Female
                   Thin   → Things/Pawn/Humanlike/Bodies/Naked_Thin
                 ★ 不要加方向后缀：原版路径本身就以 _Female 结尾，
                   Graphic_Multi 会自己拼 _south / _north / _east。 -->
            <BodyType For="Female">Things/Pawn/Humanlike/Bodies/Naked_Female</BodyType>
            <BodyType For="Thin">Things/Pawn/Humanlike/Bodies/Naked_Thin</BodyType>
            <!-- 婴儿/小孩没画，先用原版。★ Baby 在原版里继承 Juvenile，它的
                 bodyNakedGraphicPath 本来就是 Naked_Child（靠 bodyGraphicScale 缩到 0.5），
                 所以这里也填 Naked_Child —— 不要去写 Naked_Baby，那个贴图不存在。 -->
            <BodyType For="Baby" MayRequire="Ludeon.RimWorld.Biotech">Things/Pawn/Humanlike/Bodies/Naked_Child</BodyType>
            <BodyType For="Child" MayRequire="Ludeon.RimWorld.Biotech">Things/Pawn/Humanlike/Bodies/Naked_Child</BodyType>
          </extendedGraphics>
        </body>
      </graphicPaths>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>
</Defs>
