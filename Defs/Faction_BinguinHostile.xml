<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  冰鹅族【敌对派系】：冰鹅·霜牙（2026-09 用户需求）
  ────────────────────────────────────────────────────────────────────────────
  用户要求把冰鹅族拆成两个派系：
    · 和平派（已有的 Binguin）—— 中立、会派外交官（外交逻辑一个字没动）
    · 敌对派（本文件 BinguinHostile）—— 默认好感 -100、会来袭击、
      能做冰鹅族特有袭击（低温围攻、中心/四散空投、组合袭击）

  ★ 好感 -100 的实现：FactionDef 在 1.6 里【没有】naturalGoodwill / startingGoodwill
    字段（Cecil 把 FactionDef 全字段列过一遍，确认不存在）。敌对派系的标准做法就是
    原版海盗那样写 <permanentEnemy>true</permanentEnemy> —— 该派系对玩家的好感
    恒为 -100 且无法改善，这正是"默认好感 -100 + 会袭击"。

  ★ 袭击概率"比海盗略低"：走 FactionDef.raidCommonalityFromPointsCurve
    （故事叙述者挑派系袭击时的权重）。原版海盗是常数 1，这里给 0.7。

  ★ 与和平派的关系：两边共用同一套 PawnKindDef / 种族 / 装备，
    只是派系立场不同。据点名用「XX要塞」区分（和平派是「XX观察站」）。
  ============================================================================
-->
<Defs>

  <!-- ==================== 据点命名器：XX要塞 ==================== -->
  <RulePackDef>
    <defName>BinguinHostileSettlementNameMaker</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->昆仑要塞</li>
        <li>r_name->阆风要塞</li>
        <li>r_name->不周要塞</li>
        <li>r_name->阊阖要塞</li>
        <li>r_name->增城要塞</li>
        <li>r_name->县圃要塞</li>
        <li>r_name->西极要塞</li>
        <li>r_name->流沙要塞</li>
        <li>r_name->赤水要塞</li>
        <li>r_name->白水要塞</li>
        <li>r_name->幽都要塞</li>
        <li>r_name->雷渊要塞</li>
        <li>r_name->烛龙要塞</li>
        <li>r_name->玄冥要塞</li>
        <li>r_name->玄武要塞</li>
        <li>r_name->天狼要塞</li>
        <li>r_name->彗星要塞</li>
        <li>r_name->飘风要塞</li>
        <li>r_name->赤豹要塞</li>
        <li>r_name->文狸要塞</li>
        <li>r_name->深林要塞</li>
        <li>r_name->沧浪要塞</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <!-- ==================== 敌对派系 ==================== -->
  <FactionDef ParentName="FactionBase">
    <categoryTag>Outlander</categoryTag>
    <defName>BinguinHostile</defName>
    <label>冰鹅·霜牙</label>
    <description>从冰鹅族母文明中分裂出去的激进支系。他们不再满足于仰望星空，而是坚信唯有把整片寒原都踩在脚下才算完成。装备与战术和同胞一模一样，唯独不再派人交谈。</description>
    <pawnSingular>霜牙冰鹅</pawnSingular>
    <pawnsPlural>霜牙冰鹅</pawnsPlural>
    <fixedName>霜牙</fixedName>

    <leaderTitle>霜牙首席</leaderTitle>
    <leaderTitleFemale>霜牙首席</leaderTitleFemale>
    <basicMemberKind>Binguin_Militia</basicMemberKind>
    <fixedLeaderKinds>
      <li>Binguin_Leader</li>
    </fixedLeaderKinds>

    <factionIconPath>World/WorldObjects/Expanding/PirateOutpost</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <settlementNameMaker>BinguinHostileSettlementNameMaker</settlementNameMaker>

    <!-- 霜牙的配色偏冷偏暗，和和平派的雪白区分开 -->
    <colorSpectrum>
      <li>(0.30,0.38,0.52)</li>
      <li>(0.16,0.20,0.30)</li>
      <li>(0.72,0.22,0.24)</li>
    </colorSpectrum>

    <canMakeRandomly>true</canMakeRandomly>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>3</maxConfigurableAtWorldCreation>

    <techLevel>Industrial</techLevel>
    <humanlikeFaction>true</humanlikeFaction>
    <hidden>false</hidden>

    <!-- ★★ 好感机制（2026-09 用户定稿）：**默认 -100，并且会持续回落到 -100，
         但玩家可以靠送礼/和谈把好感拉回中立甚至友善**。所以：
           · 【不能】写 permanentEnemy（那才是恒 -100 且永远拉不回来）
           · 【也不能】写 naturalEnemy —— 原版 GoodwillSituationWorker_NaturalEnemy
             返回的是 **-130**（IL 实证），不是我们要的 -100
           · 改用我们自己的 GoodwillSituationDef「BinguinHostileGoodwill」
             （见本文件末尾），自然好感 = -100，回落目标就是 -100。
         世界开局时的初始好感 = -100 由 Source/Goodwill_BinguinHostile.cs 强制一次。 -->
    <permanentEnemy>false</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>

    <canSiege>true</canSiege>
    <canStageAttacks>true</canStageAttacks>

    <backstoryCategories>
      <li>Outlander</li>
      <li>Offworld</li>
    </backstoryCategories>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
      </li>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
      </li>
    </backstoryFilters>

    <!-- ★ 袭击概率：海盗是常数 1，霜牙给 0.7（"比海盗略低"） -->
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0.7)</li>
        <li>(100000, 0.7)</li>
      </points>
    </raidCommonalityFromPointsCurve>

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0, 35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35, 15)</li>
        <li>(100, 120)</li>
        <li>(1000, 500)</li>
        <li>(2000, 800)</li>
        <li>(4000, 1000)</li>
      </points>
    </raidLootValueFromPointsCurve>

    <!-- 人员构成：以 Combat / Settlement 为主（敌对派系不需要 Peaceful 访客组）。
         ★ 领袖 kind 必须出现在 Combat 组里（1.6 只在这组找 factionLeader）。 -->
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Binguin_Militia>10</Binguin_Militia>
          <Binguin_Soldier>9</Binguin_Soldier>
          <Binguin_Sapper>4</Binguin_Sapper>
          <Binguin_Scout>6</Binguin_Scout>
          <Binguin_Fighter>4</Binguin_Fighter>
          <Binguin_LeaderGuard>2</Binguin_LeaderGuard>
          <Binguin_Leader>1</Binguin_Leader>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Binguin_Settler>6</Binguin_Settler>
          <Binguin_Militia>12</Binguin_Militia>
          <Binguin_Soldier>8</Binguin_Soldier>
          <Binguin_Scout>4</Binguin_Scout>
          <Binguin_Sapper>3</Binguin_Sapper>
          <Binguin_CoserNine>1</Binguin_CoserNine>
          <Binguin_CoserDaiyousei>1</Binguin_CoserDaiyousei>
          <Binguin_LeaderGuard>1</Binguin_LeaderGuard>
          <Binguin_Leader>1</Binguin_Leader>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Binguin_CaravanLeader>1</Binguin_CaravanLeader>
          <Binguin_Merchant>1</Binguin_Merchant>
        </traders>
        <carriers>
          <Muffalo>4</Muffalo>
        </carriers>
        <guards>
          <Binguin_Soldier>4</Binguin_Soldier>
          <Binguin_Militia>3</Binguin_Militia>
        </guards>
      </li>
    </pawnGroupMakers>
  </FactionDef>

  <!-- ==================== 自然好感来源 ====================
       GoodwillSituationManager 会把所有 situation 的 naturalGoodwillOffset 加起来作为
       「自然好感」，好感每天朝它回落。这里给霜牙派系定 -100，于是：
         · 世界开局在 -100 附近
         · 玩家送礼把好感拉到 -20 → 之后会慢慢往回掉到 -100
         · 但任何时候继续送礼/和谈都能再拉回来（不是 permanentEnemy 那种锁死）

       ★ workerClass 在 XML 里写的是原版 GoodwillSituationWorker_NaturalEnemy，
         运行时由 BinguinDefPatches 换成 GoodwillSituationWorker_BinguinHostile——
         这样既保持本 mod「XML 零自定义类型」的惯例，又能精确返回 -100（原版是 -130）。 -->
  <GoodwillSituationDef>
    <defName>BinguinHostileGoodwill</defName>
    <label>宿敌</label>
    <workerClass>GoodwillSituationWorker_NaturalEnemy</workerClass>
  </GoodwillSituationDef>

</Defs>
