<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族风尘大衣 + 冰鹅族风雪大衣（2026-09 用户需求）
  两件都是【外套】(Shell 层)、85 纤维或皮革可塑；基础数值以原版
  Duster（防尘大衣）/ Parka（风雪大衣）为底，按用户给定覆盖与材质系数调整。

  · 冰鹅族风尘大衣：工作量 10000、材料 85、装备 3 秒、
      覆盖 躯干/颈部/双肩/双臂/双腿；
      材质系数：护甲 ×42%、隔冷 ×200%、隔热 ×200%
  · 冰鹅族风雪大衣：材料 85、装备 3 秒、
      覆盖 躯干/颈部/双肩/双臂（不含腿）；
      材质系数：护甲 ×42%、隔冷 ×350%、隔热 ×50%
      （工作量用户未给 → 暂用原版风雪大衣 8000，要改说一声）

  贴图：暂借原版 Duster / Parka 贴图（自带 5 体型 × 4 方向 worn 贴图集）；
  待专属美术时改 graphicData.texPath 与 apparel.wornGraphicPath 两处即可。
  制作：只在冰鹅缝纫台（2026-09 用户要求：recipeUsers 加 Inherit="False"
        阻断基类的原版手/电缝纫台继承）；解锁：冰鹅族服装（Binguin_ResearchClothing）。
  ★ 「生命阶段 成人 / 性别 无」：原版 1.6 的 Duster/Parka 本身没有这两项限制
    （属性栏默认显示），故此处也不加限制。
-->
<Defs>

  <!-- ============ 冰鹅族风尘大衣（Shell · 85 纤维/皮革 · 工作量 10000） ============ -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Binguin_Duster</defName>
    <label>冰鹅族风尘大衣</label>
    <description>冰鹅族观测者们穿在身上的长摆大衣：下摆拖到小腿，挡风、挡沙、也挡得住正午的日头。缝线里夹着一层细密绒羽，既挡尘也蓄暖，是观测站外出巡猎时最稳妥的一件。</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Duster/Duster</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.05</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costStuffCount>85</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <!-- ★ 基础数值照抄原版 Duster；材质系数按用户给定：
           护甲 ×42%（原 30%）、隔冷 ×200%（原 60%）、隔热 ×200%（原 85%） -->
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Beauty>-3</Beauty>
      <WorkToMake>10000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.42</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>2.0</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>2.0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Duster/Duster</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>IndustrialAdvanced</li>
        <li>Binguin</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.80,0.90,1.00)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.55,0.75,0.95)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.35,0.50,0.70)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.25,0.30,0.40)</min>
          <max>(0.40,0.45,0.55)</max>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>Binguin_ResearchClothing</researchPrerequisite>
      <!-- Inherit="False"：阻断基类 recipeUsers 继承 → 只在冰鹅缝纫台制作 -->
      <recipeUsers Inherit="False">
        <li>Binguin_TailoringTable</li>
      </recipeUsers>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <researchPrerequisites>
      <li>Binguin_ResearchClothing</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 冰鹅族风雪大衣（Shell · 85 纤维/皮革 · 极寒向） ============ -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Binguin_Parka</defName>
    <label>冰鹅族风雪大衣</label>
    <description>极北寒原上最要紧的外套：厚实的绒羽内衬、收紧的袖口与领口，风雪灌不进来，暖气也散不出去。穿上它，冰鹅族的守卫能在零下五十度的野外站上一整夜。</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Parka/Parka</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costStuffCount>85</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <!-- ★ 基础数值照抄原版 Parka（工作量 8000，用户未给 → 沿用）；
           材质系数按用户给定：护甲 ×42%（原 20%）、隔冷 ×350%（原 200%）、
           隔热 ×50%（原 0%） -->
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Beauty>-3</Beauty>
      <WorkToMake>8000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.42</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>3.5</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/Parka/Parka</wornGraphicPath>
      <anyTechLevelCanUseForWarmth>true</anyTechLevelCanUseForWarmth>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>IndustrialBasic</li>
        <li>Neolithic</li>
        <li>Binguin</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.80,0.90,1.00)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.55,0.75,0.95)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.35,0.50,0.70)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.25,0.30,0.40)</min>
          <max>(0.40,0.45,0.55)</max>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>Binguin_ResearchClothing</researchPrerequisite>
      <!-- Inherit="False"：阻断基类 recipeUsers 继承 → 只在冰鹅缝纫台制作 -->
      <recipeUsers Inherit="False">
        <li>Binguin_TailoringTable</li>
      </recipeUsers>
      <displayPriority>220</displayPriority>
    </recipeMaker>
    <researchPrerequisites>
      <li>Binguin_ResearchClothing</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
