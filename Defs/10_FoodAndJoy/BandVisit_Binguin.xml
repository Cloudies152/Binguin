  <!-- ==================== 演奏（演唱会开始后，乐手各就各位） ====================
       ★ 2026-09-23 用户反馈「乐队不会去麦克风方向开始演奏」：
         原来 StartConcert 只把状态置为"进行中"，【没有任何人把乐手按到乐器前】，
         乐手就一直由 Lord 的 Defend 职责在场地附近溜达。
         现在由 GameComponent_BinguinBandWatch 每 120 tick 检查一次：
         乐手不在自己的乐器前就派这个 job（走到乐器操作点 → 面向乐器演奏到散场）。 -->
  <JobDef>
    <defName>Binguin_PlayInBand</defName>
    <driverClass>Binguin.JobDriver_BinguinPlayInstrument</driverClass>
    <reportString>在冰鹅族乐队里演奏。</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

</Defs>
