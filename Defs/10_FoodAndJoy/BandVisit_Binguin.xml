<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  冰鹅族【乐队来访】事件 —— 建筑 / 服装 / 人物（XML 批，2026-09）
  ────────────────────────────────────────────────────────────────────────────
  事件流程见 Source/BandVisit_Binguin.cs。本文件只放 def。

  ★ 乐器：全部 ParentName="MusicalInstrumentBase"，该父类定义在【原版基础游戏】
    （Core/Defs/ThingDefs_Buildings/Buildings_MusicalInstruments.xml:4），
    它自带：thingClass=Building_MusicalInstrument、joyKind=HighCulture、
    hasInteractionCell、CompQuality、CompGatherSpot、播放时的 Music 音符特效、
    PlaceWorker_ShowInstrumentAoE。
    → 所以我们的乐器【功能和竖琴完全一致】，且不依赖任何 DLC。
  ★★ 乐器【必须】写 <designationCategory>Joy</designationCategory>（2026-09 修，血泪）：
     MonumentMarker 铺蓝图的前提是 def 能被玩家建造 —— IL 实证
     BuildableDef.get_BuildableByPlayer 就是 return designationCategory != null，
     蓝图 def（blueprintDef）也只对可建造的 def 生成。
     不写 → 地标上出不来"放置蓝图"、出来了也铺不出东西。
     （用户原话就是"乐器让玩家造吧"，所以进建造菜单本来就是对的。）
  ★ 统一造价：20 钢铁 + 1 零部件（用户定稿）。
  ★ 贴图目前是脚本生成的【占位图】，等用户画好替换即可（尺寸按 128px/格）。
  ============================================================================
-->
<Defs>

  <!-- ==================== 乐器 1/5：键盘（2 格） ==================== -->
  <ThingDef ParentName="MusicalInstrumentBase">
    <defName>Binguin_Band_Keyboard</defName>
    <label>冰鹅族键盘</label>
    <description>冰鹅族乐队使用的电子键盘。音色清亮如碎冰。</description>
    <size>(2,1)</size>
    <!-- ★ 2026-09-23 用户要求：操作点全部挪到乐器【后方】（远离观众那侧），
         让乐手站在乐器背后、面朝观众席演奏；麦克风仍是第一排（离观众最近那排）。
         注：地标已改成 Standable（见下方 Binguin_BandMarker 的注释），
         所以操作点落在场地范围内不会再被判定为"操作点被挡住"。 -->
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <!-- ★★★ 2026-09 修复（用户实测「放置地标后依然没法用」的真正原因）：
         MonumentMarker 要能铺蓝图，前提是这个 def 【可以被玩家建造】——
         IL 实证：MonumentMarker.GetGizmos 里判断能不能放蓝图用的是
           BuildCopyCommandUtility.FindAllowedDesignator(def, true) != null
         而 BuildableDef.get_BuildableByPlayer 的实现就是
           return designationCategory != null;
         蓝图本身（def.blueprintDef）也只对 BuildableByPlayer 的 def 生成。
         原来我们【故意不写 designationCategory】（注释还写着"不进建造菜单"），
         于是乐器既没有建造设计器、也没有蓝图 def → 地标上根本出不来"放置蓝图"，
         就算出来了点了也铺不出东西。
         ★ 而且用户早就说过「乐器让玩家造吧」——本来就该进建造菜单。
         原版娱乐建筑（马蹄桩/象棋桌等）用的就是 <designationCategory>Joy</designationCategory>。 -->
    <designationCategory>Joy</designationCategory>
    <soundPlayInstrument MayRequire="Ludeon.RimWorld.Royalty">Harp_Play</soundPlayInstrument>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>6</Mass>
      <JoyGainFactor>1</JoyGainFactor>
      <Beauty>8</Beauty>
    </statBases>
    <building>
      <instrumentRange>12</instrumentRange>
    </building>
    <!-- ★ 用户反馈：蓝图状态下会画出乐器的作用范围圈，挡视野。
         这个是 MusicalInstrumentBase 自带的 PlaceWorker_ShowInstrumentAoE 干的，
         显式覆盖成空列表即可（Inherit="False" 阻断父类列表追加语义）。 -->
    <placeWorkers Inherit="False" />
    <!-- ★ 2026-09：建造菜单图标单独用一张【128x128 正方形】的图。
         不写的话原版会拿本体贴图去套图标格（GenUI.IconDrawScale 用 drawSize/Size
         再乘 Widgets.ThingIcon 的 MiddlePart），多格乐器会被压成细条、看着又小又挤。
         图标由 Tools/Make-BandUiIcons.py 生成（素材就是本体贴图，等比缩放居中）。 -->
    <uiIconPath>Things/Building/Joy/Binguin/UI/Band_Keyboard</uiIconPath>
    <uiIconScale>1</uiIconScale>
    <graphicData>
      <texPath>Things/Building/Joy/Binguin/Band_Keyboard</texPath>
      <drawSize>(2,1)</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
    </graphicData>
  </ThingDef>

