  <!-- ==================== 冰鹅族乐队成员 ====================
       ★ 用户定稿：穿冰鹅族乐队服、拿冰鹅族冲锋枪。
       ★ 一个 PawnKind 复用 5 次（键盘/鼓/主唱/吉他/贝斯），
         具体站到哪件乐器由代码分配（见 BandVisit_Binguin.cs）。 -->
  <PawnKindDef>
    <defName>Binguin_BandMember</defName>
    <label>冰鹅族乐队成员</label>
    <race>Binguin</race>
    <defaultFactionDef>Binguin</defaultFactionDef>
    <xenotypeSet>
      <xenotypeChances>
        <Binguin_Xenotype>1.0</Binguin_Xenotype>
      </xenotypeChances>
    </xenotypeSet>
    <apparelRequired>
      <li>Binguin_BandOutfit</li>
    </apparelRequired>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <apparelMoney>0~0</apparelMoney>
    <weaponTags>
      <li>BinguinGunSMG</li>
    </weaponTags>
    <weaponMoney>500~99999</weaponMoney>
    <invNutrition>1.8</invNutrition>
    <invFoodDef>MealSimple</invFoodDef>
    <initialResistanceRange>2~8</initialResistanceRange>
    <initialWillRange>30~70</initialWillRange>
    <combatPower>45</combatPower>
  </PawnKindDef>


  <!-- ==================== 演唱会【地标】 ====================
       ★★★ 2026-09 用户要求「直接照抄原版地标」——本 def 就是原版
           Royalty\Defs\ThingDefs_Misc\Ethereal_Various.xml 里
           MonumentMarker 的【逐字段照抄】，只改了 defName/label/description/贴图。

       ★★ 为什么父类从 BuildingBase 改成 EtherealThingBase：
           原版地标继承的 EtherealThingBase 定义在【基础游戏 Core】
           （Core\Defs\ThingDefs_Misc\Ethereal_Various.xml:4，Abstract），
           **不是 Royalty** —— 所以照抄它【依然不依赖任何 DLC**。
           EtherealThingBase = category Ethereal + useHitPoints false + drawerType None。

       ★ 它自己会按 sketch 铺蓝图、判断 AllDone、显示缺蓝图/违建警告，全都白拿。

       ★★ 唯一两处「多写的」字段（都留着，原因写清楚）：
            <passability>PassThroughOnly</passability> + <pathCost>30</pathCost>
          地标的 Size = 整个场地（8×4 格），原版靠 ThingDef.ResolveReferences 的默认值
          兜成可通过；我们显式写死，避免任何情况下整块场地变成不可通行。
       ★ 贴图是占位图（Things/Building/Joy/Binguin/BandMarker）。 -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>Binguin_BandMarker</defName>
    <label>演唱会地标</label>
    <description>标出冰鹅族乐队将要演出的场地。按蓝图建好之后，乐队就会登门。</description>
    <thingClass>MonumentMarker</thingClass>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <Mass>0</Mass>
    </statBases>
    <useSameGraphicForGhost>true</useSameGraphicForGhost>
    <tickerType>Normal</tickerType>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <hasCustomRectForSelector>true</hasCustomRectForSelector>
    <drawerType>RealtimeOnly</drawerType>
    <drawOffscreen>true</drawOffscreen>
    <minifiedDef>MinifiedThing</minifiedDef>
    <drawPlaceWorkersWhileInstallBlueprintSelected>true</drawPlaceWorkersWhileInstallBlueprintSelected>
    <canLoadIntoCaravan>false</canLoadIntoCaravan>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Joy/Binguin/BandMarker</texPath>
      <shaderType>Transparent</shaderType>
      <drawRotated>false</drawRotated>
      <allowFlip>false</allowFlip>
    </graphicData>
    <building>
      <blueprintGraphicData>
        <graphicClass>Graphic_Single</graphicClass>
        <texPath>Things/Building/Joy/Binguin/BandMarker</texPath>
        <shaderType>Transparent</shaderType>
        <drawRotated>false</drawRotated>
        <allowFlip>false</allowFlip>
      </blueprintGraphicData>
      <artificialForMeditationPurposes>true</artificialForMeditationPurposes>
    </building>
    <!-- ★ 放置/安装地标时必须能看到【整个场地】的幽灵图：
         原版靠 PlaceWorker_MonumentMarker 调 MonumentMarker.DrawGhost → Sketch.DrawGhost
         画整套布局（IL 实证：PlaceWorker_MonumentMarker.DrawGhost 是它的调用者）。 -->
    <placeWorkers>
      <li>PlaceWorker_MonumentMarker</li>
    </placeWorkers>
    <!-- ★★★ 2026-09 用户实测修复（本轮的真正根因，IL 实证）：
         原来这里写的是 <passability>PassThroughOnly</passability> —— **错了**。
         原版 MonumentMarker 的 def 【根本不写 passability】（继承 EtherealThingBase，
         Traversability 字段的默认值 = Standable = 0）。

         为什么这会让乐器放不下去：
         RimWorld.GenConstruct.InteractionCellStandable(def, loc, rot, map, thingToIgnore) 里，
         对操作点那格上的每个 thing 只做一种判定（IL_006C~0076）：
             thing.def.passability != Traversability.Standable   （即 == 0）→ 报
             "InteractionSpotBlocked"（操作点被 XXX 挡住）
         Verse.Traversability 的枚举值是 Standable=0 / PassThroughOnly=1 / Impassable=2
         （IL 实证），**brtrue 判的是"非 0 就挡"** ⇒
         【PassThroughOnly 一样会挡住操作点！】
         我们的地标 Size = 整个场地，麦克风/吉他/键盘的操作点落在它格子范围内
         → 铺蓝图时被判"操作点被地标挡住" → 点"放置蓝图"什么都没发生（无红字、无日志）。

         ⇒ 修法：改回 Standable（= 原版默认），并且不再写 pathCost（原版也没有）。
         ★ 当时为了"双保险"，还把前排三件乐器（键盘/麦克风/吉他）的 interactionCellOffset
           改成了 (0,0,1)（操作点落到场地外）。**2026-09-23 用户要求改回、并统一到乐器后方**：
           见各乐器 def 上的注释 —— 地标已经是 Standable，操作点落在场地内不会被判挡住。 -->
    <passability>Standable</passability>
  </ThingDef>


  <!-- ==================== 心情：听了演唱会（用户定稿 +12 / 10 天） ==================== -->
  <ThoughtDef>
