<?xml version="1.0" encoding="utf-8"?>
<!--
  冰冠技能「投掷冰块」+ 灵造冰岩（2026-09 用户需求）
  · AbilityDef Binguin_AbilityThrowIce：charges=3（可储存 3 次）、
    cooldownTicksRange=36000（1 小时）、cooldownPerCharge=true（每次充能单独冷却
    1 小时；原版 VoidTerror 同款组合）→ 目标格投出 5 块灵造冰岩（十字分布）。
  · ThingDef Binguin_SpiritIceRock（灵造冰岩）：440 耐久、不可通行、1x1、
    tickerType Rare（供 CompBinguinSpiritIce 每 250 tick 倒计时），
    6 小时（36000 tick）后自行消融。
  · 效果类/comp 类都由 BinguinDefPatches.PatchIceCrownAbility 运行时挂载
    （XML 零自定义类型，本项目惯例）。
  · 图标：Textures/UI/Abilities/Binguin_ThrowIce.png（Tools 脚本生成的占位图）
-->
<Defs>

  <!-- ============ 灵造冰岩（技能投放物，不是玩家建筑） ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>Binguin_SpiritIceRock</defName>
    <label>灵造冰岩</label>
    <description>冰冠凝聚出的灵造冰岩：坚硬、冰凉，足以挡住子弹与风雪，但六个小时后便会重新化作细碎的冰屑。</description>
    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/Binguin/SpiritIceRock</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <!-- Rare ticker：CompBinguinSpiritIce 用 CompTickRare 倒计时 -->
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>440</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>30</Mass>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- ============ 技能：投掷冰块 ============ -->
  <AbilityDef>
    <defName>Binguin_AbilityThrowIce</defName>
    <label>投掷冰块</label>
    <description>向目标位置投出 5 块灵造冰岩，可储存 3 次。</description>
    <iconPath>UI/Abilities/Binguin_ThrowIce</iconPath>
    <!-- 1 小时 = 36000 tick；每充能各自冷却（原版 VoidTerror 组合） -->
    <cooldownTicksRange>36000~36000</cooldownTicksRange>
    <charges>3</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <writeCombatLog>true</writeCombatLog>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>25.9</range>
      <warmupTime>0.6</warmupTime>
      <drawAimPie>true</drawAimPie>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetItems>false</canTargetItems>
      </targetParams>
    </verbProperties>
  </AbilityDef>

</Defs>
