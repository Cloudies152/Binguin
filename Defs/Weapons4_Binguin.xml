<?xml version="1.0" encoding="utf-8"?>
<!--
  霰雪无垠（同终极科技）第二把终极武器：冰鹅级极激急击机枪（2026-08-20 用户需求）
  - 激光武器：弹药伤害 2、穿甲 18%；连发 99999（扫射不停）、间隔 2 tick；
    瞄准 4s；冷却 2s；射程 32；精度 20/25/25/20；抑止 0.5（1.6 无抑止，仅注释）
  - ★ 终极武器冰爆 ×2：每发面板伤害 2 → 4% 冰爆；超高射速下冰爆狂飙
  - 激光弹损伤 def：Binguin_LaserDamage（继承 Bullet），workerClass 由 Patch
    替换为 DamageWorker_BinguinIceBulletUltra（×2 冰爆）
  - 激光音效暂借原版 Shot_Minigun（持续扫射声）；激光弹贴图暂借 Bullet_Small
  - 材料：8 高级零部件 + 60 玻璃钢 + 200 钢铁；工作量 80000（用户给定）；
    技能手工未给 → 暂定 8；同科技：研究 Binguin_ResearchEndlessSnow 解锁
-->
<Defs>

  <!-- ============ 极激急击激光损伤（继承原版 Bullet） ============
       workerClass 由 Patch 替换为 DamageWorker_BinguinIceBulletUltra：
       ★ 终极冰爆 ×2（每点面板伤害 2% 冰爆）
       ★ 对建筑伤害 ×20%（用户 2026-08-20 需求：机枪打建筑只造成
         20% 伤害；对人/机械体仍是 100%） -->
  <DamageDef ParentName="Bullet">
    <defName>Binguin_LaserDamage</defName>
    <label>极激光</label>
    <buildingDamageFactor>0.2</buildingDamageFactor>
  </DamageDef>

  <!-- ============ 冰鹅级极激急击机枪（霰雪无垠解锁） ============ -->
  <ThingDef ParentName="BaseGunWithQuality">
    <defName>Binguin_LaserGatling</defName>
    <label>冰鹅级极激急击机枪</label>
    <description>霰雪无垠的终极造物：六管激光机枪，转起来便是一道不散的极光之鞭。 ⏎ （英文全名：Glacier Goose Giga-Gust Graser Gatling）</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Binguin/LaserGatling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <statBases>
      <WorkToMake>45000</WorkToMake>
      <Mass>9</Mass>
      <AccuracyTouch>0.20</AccuracyTouch>
      <AccuracyShort>0.25</AccuracyShort>
      <AccuracyMedium>0.25</AccuracyMedium>
      <AccuracyLong>0.20</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <ComponentSpacer>8</ComponentSpacer>
      <Plasteel>60</Plasteel>
      <Steel>200</Steel>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Binguin_LaserBolt</defaultProjectile>
        <warmupTime>4</warmupTime>
        <range>32</range>
        <!-- ★ 99999 连发 = 持续扫射，间隔 2 tick（≈30 发/秒） -->
        <burstShotCount>99999</burstShotCount>
        <ticksBetweenBurstShots>2</ticksBetweenBurstShots>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
      <li>GunHeavy</li>
      <li>IndustrialGunAdvanced</li>
      <li>BinguinGunGatling</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <tools>
      <li>
        <label>barrels</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <researchPrerequisites>
      <li>Binguin_ResearchEndlessSnow</li>
    </researchPrerequisites>
  </ThingDef>

  <RecipeDef>
    <defName>Recipe_Binguin_LaserGatling</defName>
    <label>制作冰鹅级极激急击机枪</label>
    <jobString>正在制作冰鹅级极激急击机枪……</jobString>
    <workAmount>45000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>60</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>200</count>
      </li>
    </ingredients>
    <products>
      <Binguin_LaserGatling>1</Binguin_LaserGatling>
    </products>
    <recipeUsers>
      <li>Binguin_MachiningTable</li>
    </recipeUsers>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <researchPrerequisite>Binguin_ResearchEndlessSnow</researchPrerequisite>
  </RecipeDef>

  <!-- ============ 极激光束（Beam 射线弹，2026-08-20 用户修正：
       不是普通子弹而是「类似射线」——原版激光武器机制：
       thingClass=Beam 瞬时命中 + beamMoteDef 生成枪口→目标的光束视觉） ============ -->
  <ThingDef ParentName="BaseBullet">
    <defName>Binguin_LaserBolt</defName>
    <label>极激光束</label>
    <thingClass>Beam</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Binguin_LaserDamage</damageDef>
      <damageAmountBase>2</damageAmountBase>
      <armorPenetrationBase>0.26</armorPenetrationBase>
      <!-- ★ 射线视觉：光束从枪口外 0.5 格处连到命中点 -->
      <beamMoteDef>Binguin_LaserBeamMote</beamMoteDef>
      <beamStartOffset>0.5</beamStartOffset>
    </projectile>
  </ThingDef>

  <!-- ============ 极激光光束视觉（照抄原版 Odyssey Mote_BeamRepeaterLaser，
       纹理用原版 GraserBeam 资源——用户环境已装 Odyssey 可正常加载） ============ -->
  <ThingDef ParentName="MoteBase">
    <defName>Binguin_LaserBeamMote</defName>
    <thingClass>MoteDualAttached</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.08</fadeInTime>
      <fadeOutTime>0.08</fadeOutTime>
      <solidTime>0.08</solidTime>
      <rotateTowardsTarget>True</rotateTowardsTarget>
      <scaleToConnectTargets>True</scaleToConnectTargets>
    </mote>
    <drawOffscreen>true</drawOffscreen>
    <graphicData>
      <texPath>Things/Mote/GraserBeam</texPath>
      <graphicClass>Graphic_MoteWithAgeSecs</graphicClass>
      <shaderType>MoteBeam</shaderType>
      <shaderParameters>
        <_ExtraTexA>/Things/Mote/BeamSecondaryNoise_A</_ExtraTexA>
        <_ExtraTexB>/Things/Mote/BeamSecondaryNoise_B</_ExtraTexB>
        <_ScrollSpeedA>0</_ScrollSpeedA>
        <_ScrollSpeedB>0</_ScrollSpeedB>
        <_Intensity>2</_Intensity>
      </shaderParameters>
    </graphicData>
  </ThingDef>

</Defs>
