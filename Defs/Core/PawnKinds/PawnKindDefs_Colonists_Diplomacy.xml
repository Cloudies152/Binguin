<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族基础殖民者 + 冰鹅族常服（2026-08-19 用户设计）
  ★ 殖民者不会自然生成（无 defaultFactionDef），只在冰鹅族剧本
    （Binguin_Scenario，AdvancedFishing 文件夹）开局供玩家选择。
  ★ 常服数值：照抄原版部落装（Apparel_TribalA：costStuffCount 60、
    Fabric+Leathery）→ 耐寒 ×200%（Insulation_Cold 0.55→1.10）、
    其他数值 ×1.1 左右；覆盖左右肩部/手臂/躯干/腿部/脚部。
-->
<Defs>

  <!-- ============ 冰鹅族常服（60 皮革/布料/毛料，OnSkin 连体服） ============
       覆盖：左右肩部、左右手臂、躯干、左右腿部、左右脚部 -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Binguin_Tribalwear</defName>
    <label>冰鹅族常服</label>
    <description>冰鹅族以厚布缝制的连体常服，覆及肩臂躯干与腿脚。极寒之中依旧从容。</description>
    <graphicData>
      <texPath>Things/Apparel/Binguin/Tribalwear</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costStuffCount>60</costStuffCount>
    <!-- ★ 1.6 无 Wooly 类别：羊毛（WoolSheep 等）本身就归 Fabric（2026-08-20 修） -->
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <tradeability>Sellable</tradeability>
    <statBases>
      <!-- ★ 原版部落装数值（0.2/0.55/0.55/0.5/1800/100）→ 耐寒×2、其他×1.1 -->
      <MaxHitPoints>110</MaxHitPoints>
      <WorkToMake>2000</WorkToMake>
      <Mass>0.55</Mass>
      <StuffEffectMultiplierArmor>0.22</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.60</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <!-- ★ 2026-09 用户要求：冰鹅族常服 +5% 全局工作效率
           （原版 WorkSpeedGlobal，默认 1；+0.05 = +5%） -->
      <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Torso</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/Binguin/Tribalwear/Tribalwear</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>Binguin</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>Binguin_ResearchClothing</researchPrerequisite>
      <!-- ★ 2026-09：Inherit="False" 阻断基类 ApparelMakeableBase 的 recipeUsers
           继承（XML List 是追加语义，否则原版手/电缝纫台也能做）——
           冰鹅族衣物只在冰鹅缝纫台制作。原版 Royalty 大铠同款写法。 -->
      <recipeUsers Inherit="False">
        <li>Binguin_TailoringTable</li>
      </recipeUsers>
      <displayPriority>200</displayPriority>
    </recipeMaker>
    <researchPrerequisites>
      <li>Binguin_ResearchClothing</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 冰鹅族基础殖民者（不自然生成，仅剧本开局可选） ============
       照抄原版 Colonist（BasePlayerPawnKind）：
       - 种族 = 冰鹅（Binguin）+ 冰鹅种异种
       - 强制穿冰鹅族常服（apparelRequired）
       - 携带 8~16 根芝士条或鱼干（inventoryOptions 随机二选一） -->
  <PawnKindDef ParentName="BasePlayerPawnKind">
    <defName>Binguin_Colonist</defName>
    <label>冰鹅族殖民者</label>
    <!-- ★ defaultFactionDef = 玩家派系（与 vanilla Colonist→PlayerColony 同构）：
         仅玩家剧本生成时引用，不加入任何 NPC pawnGroupMakers → 仍不会自然生成。
         ★ 2026-08-20：随剧本改用独立玩家派系 Binguin_PlayerColony -->
    <defaultFactionDef>Binguin_PlayerColony</defaultFactionDef>
    <race>Binguin</race>
    <chemicalAddictionChance>0.06</chemicalAddictionChance>
    <!-- ★ xenotypeChances 必须包在 xenotypeSet 内（2026-08-20 修：裸写不识别） -->
    <xenotypeSet>
      <xenotypeChances>
        <Binguin_Xenotype>1.0</Binguin_Xenotype>
      </xenotypeChances>
    </xenotypeSet>
    <!-- 强制穿常服；apparelMoney 0：不额外配衣服 -->
    <apparelRequired>
      <li>Binguin_Tribalwear</li>
    </apparelRequired>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <apparelMoney>0~0</apparelMoney>
    <backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
    <techHediffsChance>0.03</techHediffsChance>
    <techHediffsMoney>50~800</techHediffsMoney>
    <techHediffsTags>
      <li>Poor</li>
      <li>Simple</li>
      <li>ImplantEmpireCommon</li>
    </techHediffsTags>
    <techHediffsDisallowTags>
      <li>PainCauser</li>
    </techHediffsDisallowTags>
    <initialResistanceRange>13~21</initialResistanceRange>
    <initialWillRange>0~0</initialWillRange>
    <!-- ★ 干粮：芝士条或鱼干，8~16 根（subOptionsChooseOne = 随机二选一） -->
    <inventoryOptions>
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>Binguin_CheeseSticks</thingDef>
          <countRange>8~16</countRange>
        </li>
        <li>
          <thingDef>Binguin_FishJerky</thingDef>
          <countRange>8~16</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

</Defs>
