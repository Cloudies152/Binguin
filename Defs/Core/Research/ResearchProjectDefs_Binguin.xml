<?xml version="1.0" encoding="utf-8"?>
<!--
  冰山科技研究线（本文件只含当前已实现的两个基础科技：
  增冰鹅鹅 / 环境保护。其余科技（冰鹅机加工等）后续补充）
  ★ 1.6 注意：ResearchProjectDef 无 unlockThings/unlockRecipes 字段（旧版字段），
    解锁改用"反向引用"：各 ThingDef 的 <researchPrerequisites> 与 RecipeDef 的
    <researchPrerequisite> 指向本研究。
-->
<Defs>

  <!-- 科研栏分类：冰山科技 -->
  <ResearchTabDef>
    <defName>Binguin_ResearchTab</defName>
    <label>冰山科技</label>
  </ResearchTabDef>

  <!-- ============ 增冰鹅鹅（最基础科技，600 点） ============
       ★ 双关名：化用《楚辞·招魂》「增冰峨峨，飞雪千里些。」之音，
         「峨」→「鹅」接冰鹅族（用户 2026-08-20 定名）。
       解锁（反向引用）：采切石一体机、冰岩/冰岩砖、鱼干/芝士条、臭鱼罐头、6 种家具
       ★ 2026-10-02 用户要求把【臭鱼罐头】放进本科技 ⇒ 它的解锁关系写在
         `AdvancedFishing\Defs\Feature\RaceTraits\Fishing_StinkFishCan.xml` 的
         `Make_Binguin_StinkFishCan` 的 `<researchPrerequisite>` 上。 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchIcyPeaks</defName>
    <label>增冰鹅鹅</label>
    <description>他们掌握了将寒原资源化为日用之物的工艺：自动采切石料、制作鱼干、芝士条与腌到发臭的鱼罐头，以及蓝黑相间的冰雪家具。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>600</baseCost>
    <researchViewX>0.00</researchViewX>
    <researchViewY>1.60</researchViewY>
  </ResearchProjectDef>

  <!-- ============ 环境保护（另一条科技线的基础，500 点） ============
       解锁（反向引用）：高级排污泵 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchEnvironment</defName>
    <label>环境保护</label>
    <description>因为某种原因，他们改进出效率远胜原版的高级排污泵。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>500</baseCost>
    <researchViewX>0.00</researchViewX>
    <researchViewY>4.00</researchViewY>
  </ResearchProjectDef>

  <!-- ============ 垃圾回收（前置：环境保护，1200 点） ============
       解锁（反向引用）：冰鹅族垃圾回收器 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchRecycling</defName>
    <label>垃圾回收</label>
    <description>现在，冰鹅族将污染视为可再生的资源。他们造出全新的垃圾回收器，把有毒垃圾分解为可用的矿物。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>1200</baseCost>
    <!-- ★ 2026-09 用户要求：本科技必须在【高级研究台】上研究 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>1.40</researchViewX>
    <researchViewY>3.20</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchEnvironment</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 高效垃圾回收 ProPlusMax（前置：垃圾回收，2000 点） ============
       纯被动强化（无新建筑）：研究完成后，垃圾回收器每次回收的矿物
       产量提高 50%（8~15 个，原 5~10）。用户代号「垃圾回收器 proplusmax」。
       前置 = 垃圾回收（Binguin_ResearchRecycling，2026-08-20 用户改定：
       先有回收器才有强化）。★ 2026-09 修正：原坐标 (3.0,2.6) 与冰鹅族护甲
       (3.0,2.4) 行距仅 0.2 < 节点高 0.5 → 两节点在树上是【叠着的】（用户
       反馈"重合"的真凶）；改到 (4.4,3.3)：与天问(4.4,1.6) 行距 1.7、与护甲
       列距 1.4，连线从护甲节点上方绕过，不压节点。
       C# 侧 CompBinguinRecycler.DoRecycleOne 检查本研究 IsFinished 生效。 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchRecyclingProMax</defName>
    <label>高效垃圾回收</label>
    <description>冰鹅族的工程师改进了回收器的分解工艺——同样的有毒垃圾，如今能榨取出多五成的可用矿物。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>2000</baseCost>
    <!-- ★ 2026-09 用户要求：本科技必须在【高级研究台】上研究，且旁边要有【多元分析仪】 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>2.80</researchViewX>
    <researchViewY>3.20</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchRecycling</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 大气控制（前置：环境保护，2000 点） ============
       解锁（反向引用）：冰鹅族大气控制仪 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchAtmosphere</defName>
    <label>大气控制</label>
    <description>冰鹅族的观测者深谙天象。他们造出大气控制仪，以寒能驱动天穹——晴雨风雪，尽在掌中。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>2000</baseCost>
    <!-- ★ 2026-09 用户要求：本科技必须在【高级研究台】上研究 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>1.40</researchViewX>
    <researchViewY>4.00</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchEnvironment</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 冰鹅机加工（前置：增冰鹅鹅） ============
       解锁（反向引用）：冰鹅族机工台、冰鹅族基础武器（冲锋枪/霰弹枪/杠杆步枪）、
       自动加特林塔（还需 HeavyTurrets）、小型自动霰弹发射塔（还需原版 GunTurrets）。
       ★ "反向引用"= 解锁关系写在 ThingDef 的 <researchPrerequisites> 里，
         研究界面会自动把它列进本项目的 Unlocks，不需要在这里写 <unlocks> 节点。 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchMachining</defName>
    <label>冰鹅机加工</label>
    <description>冰鹅族的工匠将钢铁锻造成精密的机件，制造出耐寒的机械加工台——在刺骨低温中依旧运转如常。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>1200</baseCost>
    <researchViewX>1.40</researchViewX>
    <researchViewY>0.80</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 冰鹅族服装（前置：增冰鹅鹅；联动机加工解锁防弹背心） ============
       解锁：冰鹅族缝纫台；防弹背心需同时研究服装与机加工 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchClothing</defName>
    <label>冰鹅族服装</label>
    <description>冰鹅族的缝纫工艺，以蓝黑绒羽与寒冰纤维织就衣物。结合机加工技术，还能打造出冰岩防弹背心。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>1000</baseCost>
    <researchViewX>1.40</researchViewX>
    <researchViewY>1.60</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 冰鹅族cos服（前置：冰鹅族服装，支线，100 点） ============
       解锁（反向引用）：企鹅连体衣 + ⑨服 + 大酱服
       （后两件数值/覆盖/材料全部参考连体衣，只是外观不同）
       布局：★ 2026-09 用户要求挪到【冰鹅族护甲(3.0,2.4)的左下】→ (2.3, 4.6)。
       （原 (3.0,0.8) 与护甲同列，虽行距 1.6 不重合，但同列已挤了 5 个节点）
       几何依据（原版节点 136×50px＝坐标 1.36×0.5，重合判定 |dx|<1.36 且 |dy|<0.5）：
       中间列 x≈2.3 被服装列(1.6)与钓鱼列(3.0)的密集行位卡死，唯一空行是 y≥4.5
       （与星空眺望 1.6,4.0 留 0.5 余量）→ 取 4.6；连线 服装(1.6,0.8)→此处
       全程走在空列上，不穿任何节点。 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchCosplay</defName>
    <label>冰鹅族cos服</label>
    <description>观测之余的一点小小爱好：冰鹅族的少女们把绒羽与布料裁成各式各样"传说中的装束"，穿上便觉得自己成了故事里的角色。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>100</baseCost>
    <researchViewX>2.80</researchViewX>
    <researchViewY>1.60</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchClothing</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 星空眺望（前置：环境保护，2000 点） ============
       解锁（反向引用）：冰鹅族陨石引导器 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchStargazing</defName>
    <label>星空眺望</label>
    <description>冰鹅族的观测者彻夜仰望群星，终于学会读懂流星的语言。他们造出陨石引导器，以引力牵引天外之物，将陨石化为寒原的馈赠。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>2000</baseCost>
    <!-- ★ 2026-09 用户要求：本科技必须在【高级研究台】上研究 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>1.40</researchViewX>
    <researchViewY>4.80</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchEnvironment</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 突袭冷冻武器（前置：冰鹅机加工，1600 点） ============
       解锁（反向引用）：冰鹅族突击步枪（含 12%/发 冰爆，满 100% 冻碎随机部位）
       布局：机加工 (1.6,0) → 突袭冷冻武器 (3.0,0) → 精准步枪 (3.0,0.8) -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchFrostAssault</defName>
    <label>突袭冷冻武器</label>
    <description>冰鹅族的匠人把极寒晶簇凝进弹头：冰爆弹命中即在敌体内凝集寒能，冰爆蓄满之时，被击中的部位会骤然冻裂崩碎。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Industrial</techLevel>
    <baseCost>1600</baseCost>
    <!-- ★ 2026-09 用户要求：本科技必须在【高级研究台】上研究 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <researchViewX>2.80</researchViewX>
    <researchViewY>0.00</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchMachining</li>
      <li>PrecisionRifling</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 霰雪无垠（终极研究，前置：突袭冷冻武器 + 冰鹅族护甲，5000 点） ============
       解锁（反向引用）：企鹅飞踢！！+ 极激急击机枪（终极冰爆×2）
       布局：(4.4, 0.8) 独立一列——把 x3.0 列让给冰鹅族护甲线
       （2026-08-20 用户改定：护甲与冷冻武器同列） -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchEndlessSnow</defName>
    <label>霰雪无垠</label>
    <description>无垠霰雪中，身影如电，此技一出，便是终极。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Spacer</techLevel>
    <baseCost>5000</baseCost>
    <!-- ★ 2026-09（用户需求）：本科技需要一张【蓝图】才能开始研究——
         原版科技图纸 Techprint（ThingDefGenerator_Techprints 会依
         techprintCount>0 自动生成 defName = Techprint_Binguin_ResearchEndlessSnow
         的物品，市价取 techprintMarketValue）。
         蓝图获取：稀有贸易商（稀有品商队/轨道稀有品商）概率出售 +
         冰鹅族据点 70% 概率出售（见 BinguinDefPatches.PatchBinguinBlueprintTraders）。
         MayRequire Royalty：未装 Royalty 时不生成科技图纸，避免科技被硬锁死。 -->
    <!-- ★ 2026-09：声明科技图纸由哪类派系持有（原版必须写，否则每次启动报
         「requires techprints but has no heldByFactionCategoryTags」红字）。
         配套：Defs/Feature/Diplomacy/FactionDefs_Binguin.xml 补 <categoryTag>Outlander</categoryTag>。 -->
    <heldByFactionCategoryTags MayRequire="Ludeon.RimWorld.Royalty">
      <li>Outlander</li>
    </heldByFactionCategoryTags>
    <techprintCount MayRequire="Ludeon.RimWorld.Royalty">1</techprintCount>
    <techprintCommonality MayRequire="Ludeon.RimWorld.Royalty">1</techprintCommonality>
    <techprintMarketValue MayRequire="Ludeon.RimWorld.Royalty">3000</techprintMarketValue>
    <!-- ★ v23（用户拍板）：终极科技需在高级研究台 + 多元分析仪旁研究 -->
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <researchViewX>4.20</researchViewX>
    <researchViewY>0.40</researchViewY>
    <!-- ★ 2026-09 用户定稿：霰雪无垠的前置——
         ① 突袭冷冻武器（冰爆武器线）② 冰鹅族护甲（护甲线）
         ③ 原版【精密装配 Fabrication】（2026-09 用户追加）。
         前两个画在树上是两条汇入的线，位置取两前置之间的中线 (4.2, 0.4)；
         第 ③ 个是原版项目（在 Main 标签页，(16.0, 3.0)），跨标签页引用
         —— 本 MOD 已有先例（突袭冷冻武器就引用了原版 PrecisionRifling），
         游戏里表现为"还差一个其他页签的科技"，不会画跨页连线。 -->
    <prerequisites>
      <li>Binguin_ResearchFrostAssault</li>
      <li>Binguin_ResearchIceArmor</li>
      <li>Fabrication</li>
    </prerequisites>
  </ResearchProjectDef>

  <!-- ============ 冰鹅族护甲（前置：冰鹅机加工+冰鹅族服装+原版防弹衣，2000 点） ============
       解锁（反向引用）：哨骑头盔 + 哨骑装甲（Defs/Armor_Binguin.xml）
       布局：(3.0, 2.4) —— 与突袭冷冻武器同 x3.0 列（用户 2026-08-20 改定）；
       y2.4 下方 (3.0, 3.2)/(3.0, 4.0) 留空给护甲线下一项科技 -->
  <ResearchProjectDef>
    <defName>Binguin_ResearchIceArmor</defName>
    <label>冰鹅族护甲</label>
    <description>冰鹅族的匠人把玻璃钢织成护甲：轻盈如羽、坚逾寒铁，连真空与极寒也无法阻拦哨骑的巡猎。</description>
    <tab>Binguin_ResearchTab</tab>
    <techLevel>Spacer</techLevel>
    <baseCost>2000</baseCost>
    <researchViewX>2.80</researchViewX>
    <researchViewY>0.80</researchViewY>
    <prerequisites>
      <li>Binguin_ResearchMachining</li>
      <li>Binguin_ResearchClothing</li>
      <li>FlakArmor</li>
    </prerequisites>
  </ResearchProjectDef>

</Defs>
