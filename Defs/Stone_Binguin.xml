<?xml version="1.0" encoding="utf-8"?>
<!--
  冰岩 / 冰岩砖：
  冰岩 = 采切石一体机在冰面采出的原岩（类似原版岩石块 ChunkGranite），
         可被切石桌（TableStonecutter）切制成冰岩砖（butcherProducts 机制，1 块 → 20 砖）。
  冰岩砖 = 建筑材料 stuff（参考原版大理石砖 BlocksMarble），带用户指定的材料乘数
          （stuffProps.statFactors）。
-->
<Defs>

  <!-- ============ 冰岩（原岩） ============ -->
  <ThingDef ParentName="ChunkRockBase">
    <defName>Binguin_IceRock</defName>
    <label>冰岩</label>
    <description>从寒原冰层深处采出的冰蓝岩块，冷冽剔透。可在切石桌上切成冰岩砖。</description>
    <graphicData>
      <color>(150,175,210)</color>
    </graphicData>
    <statBases>
      <Mass>20</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <researchPrerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </researchPrerequisites>
    <butcherProducts>
      <Binguin_IceRockBrick>20</Binguin_IceRockBrick>
    </butcherProducts>
  </ThingDef>

  <!-- ============ 冰岩砖（建筑材料 stuff） ============ -->
  <ThingDef ParentName="StoneBlocksBase">
    <defName>Binguin_IceRockBrick</defName>
    <label>冰岩砖</label>
    <description>以冰岩切割而成的冰蓝色砖块。比寻常石材更轻盈坚韧，广受冰鹅族建筑师青睐。</description>
    <graphicData>
      <texPath>Things/Item/Binguin/IceRockBrick</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>1.25</Mass>
    </statBases>
    <researchPrerequisites>
      <li>Binguin_ResearchIcyPeaks</li>
    </researchPrerequisites>
    <stuffProps>
      <color>(130,160,200)</color>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <stuffAdjective>冰岩</stuffAdjective>
      <!-- 用户指定的材料乘数（StatDef 名与数值） -->
      <statFactors>
        <ArmorRating_Sharp>0.6</ArmorRating_Sharp>            <!-- 利器伤害 x60% -->
        <ArmorRating_Blunt>1.0</ArmorRating_Blunt>            <!-- 钝器伤害 x100% -->
        <JoyGainFactor>1.0</JoyGainFactor>                    <!-- 娱乐效力 x100% -->
        <MarketValue>0.4</MarketValue>                        <!-- 价值乘数 x40% -->
        <MaxHitPoints>1.5</MaxHitPoints>                      <!-- 耐久度乘数 x150% -->
        <Beauty>1.2</Beauty>                                  <!-- 美观度乘数 x120% -->
        <Flammability>0</Flammability>                        <!-- 易燃性乘数 x0% -->
        <DoorOpenSpeed>1.0</DoorOpenSpeed>                    <!-- 开门速度 x100% -->
        <MeleeWeapon_CooldownMultiplier>1.3</MeleeWeapon_CooldownMultiplier> <!-- 近战冷却时间 x130% -->
        <WorkToBuild>1.2</WorkToBuild>                        <!-- 建造工作量系数 x120% -->
        <WorkToMake>0.8</WorkToMake>                          <!-- 制作工作量系数 x80% -->
      </statFactors>
    </stuffProps>
  </ThingDef>

</Defs>
