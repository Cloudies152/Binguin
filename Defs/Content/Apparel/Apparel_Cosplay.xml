<?xml version="1.0" encoding="utf-8"?>
<!--
  冰鹅族cos服支线两件：⑨服 + 大酱服（2026-09 用户需求）
  · 两者【全部参考企鹅连体衣】（Defs/Jumpsuit_Binguin.xml）：
      外套 Shell 层 · 120 纤维或皮革 · 装备 1.5 秒 · HP100 / 工作量4000 / 重量1
      覆盖 FullHead/UpperHead/Neck/Shoulders/Torso/Legs/Arms（含头部渲染屏蔽）
      材质系数：护甲 ×30%、隔冷 ×200%、隔热 ×100%
      只在冰鹅缝纫台制作（recipeUsers Inherit="False"）
  · 解锁：支线研究「冰鹅族cos服」Binguin_ResearchCosplay（前置冰鹅族服装，100 点）
  · 贴图：暂借冰鹅族常服贴图 + 各自的配色（⑨=冰蓝白 / 大酱=浅绿白）以作区分；
    待专属美术时按 <目录>/<前缀>_<体型>_<方向>.png 放好，改 texPath/wornGraphicPath。
    若专属美术本身不带兜帽，可把本件的 renderSkipFlags 去掉（说一声即可）。
-->
<Defs>

  <!-- ============ ⑨服（冰蓝白，参考连体衣） ============ -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Binguin_CosNine</defName>
    <label>⑨服</label>
    <description>冰蓝与纯白拼色的裙装，和一个巨大的蝴蝶结。有这神奇的力量——穿上它的冰鹅族少女总会不自觉地挺起胸膛，说话也大声了几分。</description>
    <graphicData>
      <texPath>Things/Apparel/Binguin/Tribalwear</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <tradeability>Sellable</tradeability>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <Beauty>-3</Beauty>
      <WorkToMake>4000</WorkToMake>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>2.0</StuffEffectMultiplierInsulation_Cold>
      <!-- ★ 2026-09 用户要求：cos 服额外 +30℃ 耐寒（绝对值，叠加在材质保暖之上）。
           布料制 = 2.0×18 + 30 = 66℃，即能撑到约 -66℃；皮革/毛料更高。 -->
      <Insulation_Cold>30</Insulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>1.0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.4</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
        <li>UpperHead</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Torso</li>
        <li>Legs</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/Binguin/Tribalwear/Tribalwear</wornGraphicPath>
      <blocksAddedPartWoundGraphics>true</blocksAddedPartWoundGraphics>
      <renderSkipFlags>
        <li>Head</li>
        <li>Hair</li>
        <li>Beard</li>
        <li>Eyes</li>
      </renderSkipFlags>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Binguin</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
      <drawData>
        <defaultData>
          <layer>83</layer>
        </defaultData>
      </drawData>
    </apparel>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <!-- 占位配色：冰蓝白（专属贴图到位后可删掉整个 colorGenerator） -->
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>12</weight>
          <only>(0.90,0.95,1.00)</only>
        </li>
        <li>
          <weight>12</weight>
          <only>(0.55,0.75,0.95)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.30,0.50,0.80)</only>
        </li>
        <li>
          <weight>4</weight>
          <only>(0.85,0.25,0.30)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>Binguin_ResearchCosplay</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>Binguin_TailoringTable</li>
      </recipeUsers>
      <displayPriority>171</displayPriority>
    </recipeMaker>
    <researchPrerequisites>
      <li>Binguin_ResearchCosplay</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 大酱服（浅绿白，参考连体衣） ============ -->
