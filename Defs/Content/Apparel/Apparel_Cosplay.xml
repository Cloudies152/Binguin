    <!-- 占位配色：浅绿白（专属贴图到位后可删掉整个 colorGenerator） -->
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>12</weight>
          <only>(0.92,0.98,0.90)</only>
        </li>
        <li>
          <weight>12</weight>
          <only>(0.60,0.85,0.62)</only>
        </li>
        <li>
          <weight>8</weight>
          <only>(0.35,0.65,0.45)</only>
        </li>
        <li>
          <weight>4</weight>
          <only>(0.45,0.60,0.90)</only>
        </li>
      </options>
    </colorGenerator>
    <recipeMaker>
      <researchPrerequisite>Binguin_ResearchCosplay</researchPrerequisite>
      <recipeUsers Inherit="False">
        <li>Binguin_TailoringTable</li>
      </recipeUsers>
      <displayPriority>172</displayPriority>
    </recipeMaker>
    <researchPrerequisites>
      <li>Binguin_ResearchCosplay</li>
